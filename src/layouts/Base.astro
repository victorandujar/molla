---
import '../styles/global.css';
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wdth-normal.woff2?url';
import bodyFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoFont from '@fontsource/space-mono/files/space-mono-latin-400-normal.woff2?url';
import Ribbon from '../components/Ribbon.astro';
import Crumb from '../components/Crumb.astro';
import { brand, searchIndexable, isDemo } from '../lib/config';
import { ui, routes, type Lang, type RouteKey } from '../lib/i18n';
import { deliveryTowns, deliveryWindow } from '../lib/delivery';
interface Props {
  lang?: Lang;
  route?: RouteKey;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
}
const {
  lang = 'ca',
  route,
  title = ui[lang].meta.title,
  description = ui[lang].meta.description,
  image = '/images/social.jpg',
  noindex = false,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'es' ? 'ca' : 'es';
const home = routes.home[lang];
const abs = (path: string) =>
  brand.site ? new URL(path, brand.site).href : null;
const canonical = abs(route ? routes[route][lang] : Astro.url.pathname);
const indexable = searchIndexable && !noindex;
const sameAs = [
  brand.instagram,
  brand.whatsappChannel,
  brand.googleProfile,
].filter(Boolean);
// A service-area bakery: no public address, delivery on Wednesdays and
// Saturdays in its towns.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  '@id': abs('/#organization'),
  name: brand.name,
  legalName: brand.legalName || undefined,
  url: abs('/'),
  logo: abs('/icon-512.png'),
  image: abs('/images/social.jpg'),
  description: ui[lang].meta.description,
  email: brand.contact || undefined,
  telephone: brand.whatsapp ? `+${brand.whatsapp}` : undefined,
  sameAs: sameAs.length ? sameAs : undefined,
  priceRange: '€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Cash',
  servesCuisine: lang === 'ca' ? 'Pa artesà' : 'Pan artesano',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sant Boi de Llobregat',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  areaServed: [
    ...deliveryTowns.map((town) => ({ '@type': 'City', name: town.name })),
    { '@type': 'AdministrativeArea', name: 'Baix Llobregat' },
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['https://schema.org/Wednesday', 'https://schema.org/Saturday'],
    opens: deliveryWindow.split('–')[0],
    closes: deliveryWindow.split('–')[1],
  },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  url: abs('/'),
  name: brand.name,
  inLanguage: ['ca', 'es'],
  publisher: { '@id': abs('/#organization') },
};
const webpage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical ? `${canonical}#webpage` : undefined,
  url: canonical || undefined,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': abs('/#website') },
  about: { '@id': abs('/#organization') },
};
const graph = [organization, website, webpage, ...jsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={displayFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={bodyFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={monoFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#f6efe5" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={brand.name} />
    <meta
      name="robots"
      content={
        indexable
          ? 'index, follow, max-image-preview:large'
          : 'noindex, nofollow'
      }
    />
    {canonical && <link rel="canonical" href={canonical} />}
    {brand.googleSiteVerification && (
      <meta
        name="google-site-verification"
        content={brand.googleSiteVerification}
      />
    )}
    {brand.bingSiteVerification && (
      <meta name="msvalidate.01" content={brand.bingSiteVerification} />
    )}
    {route && brand.site && (
      <>
        <link rel="alternate" hreflang="ca" href={abs(routes[route].ca)} />
        <link rel="alternate" hreflang="es" href={abs(routes[route].es)} />
        <link
          rel="alternate"
          hreflang="x-default"
          href={abs(routes[route].ca)}
        />
      </>
    )}
    <meta name="geo.region" content="ES-CT" />
    <meta name="geo.placename" content="Sant Boi de Llobregat" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'ca' ? 'es_ES' : 'ca_ES'}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && (
      <>
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={abs(image)} />
        <meta property="og:image:secure_url" content={abs(image)} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {abs(image) && <meta name="twitter:image" content={abs(image)} />}
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    {searchIndexable && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#contenido">
      {t.skip}
    </a>
    {isDemo && (
      <div class="demo-note" role="region" aria-label="Demo">
        {t.demo}
      </div>
    )}
    <header class="site-header" data-header>
      <div class="wrap header-inner">
        <a class="wordmark" href={home} aria-label={t.home}>
          {brand.name.toLowerCase()}
          <span class="wordmark-dot">.</span>
        </a>
        <nav aria-label={lang === 'ca' ? 'Principal' : 'Principal'}>
          <a class="nav-hide" href={`${home}#carta`}>
            {lang === 'ca' ? 'La carta' : 'La carta'}
          </a>
          <a class="nav-hide" href={`${home}#proceso`}>
            {t.nav.process}
          </a>
          <a class="nav-hide" href={routes.delivery[lang]}>
            {t.nav.delivery}
          </a>
          <a class="nav-hide" href={`${home}#preguntas`}>
            {t.nav.faq}
          </a>
          {route && (
            <a
              class="lang-switch"
              href={routes[route][other]}
              hreflang={other}
              lang={other}
              aria-label={t.switchAria}
            >
              {other.toUpperCase()}
            </a>
          )}
          <a class="nav-order" href={`${home}#reserva`}>
            {t.nav.order}
            <span class="nav-count" data-cart-count hidden>
              0
            </span>
          </a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <!-- El envoltorio: el único sitio donde aparece la miga del packaging. -->
      <div class="wrapper-panel" data-wrapper>
        <div class="wrapper-field">
          <Crumb />
        </div>
        <Ribbon
          words={t.hero.ribbon}
          class="wrapper-ribbon wrapper-ribbon-top"
        />
        <Ribbon
          words={t.hero.ribbon}
          class="wrapper-ribbon wrapper-ribbon-bottom"
          reverse
        />
        <a class="wrapper-label" href={home} aria-label={t.home} data-wave>
          <span class="footer-mark">
            {[...brand.name.toLowerCase()].map((c) => (
              <span class="wave-letter">{c}</span>
            ))}
            <span class="wave-letter wave-dot">.</span>
          </span>
          <span class="wrapper-line">{t.footer.line}</span>
        </a>
      </div>
      <div class="wrap footer-inner">
        <p>
          <span>{t.footer.area}</span>
        </p>
        <div class="footer-links">
          <a href={routes.poolish[lang]}>Poolish</a>
          <a href={routes.delivery[lang]}>{t.nav.delivery}</a>
          <a href={routes.standing[lang]}>{t.nav.standing}</a>
          <a href={routes.pickup[lang]}>{t.nav.pickup}</a>
          {route && (
            <a href={routes[route][other]} hreflang={other} lang={other}>
              {t.switchLabel}
            </a>
          )}
          <a href={routes.privacy[lang]}>{t.footer.privacy}</a>
          {brand.whatsappChannel && (
            <a
              data-event="click_channel"
              href={brand.whatsappChannel}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.footer.channel} ↗
            </a>
          )}
          {brand.instagram && (
            <a
              data-event="click_instagram"
              href={brand.instagram}
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram ↗
            </a>
          )}
          {brand.contact && (
            <a href={`mailto:${brand.contact}`}>{t.footer.write}</a>
          )}
        </div>
        <small>
          © {new Date().getFullYear()} {brand.name}
        </small>
      </div>
    </footer>
    <script src="../lib/client.ts"></script>
    <script src="../lib/motion.ts"></script>
  </body>
</html>
