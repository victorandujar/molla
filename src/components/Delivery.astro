---
import Article from '../layouts/Article.astro';
import Photo from './Photo.astro';
import { brand, isDemo, launchReady, money, productById } from '../lib/config';
import {
  deliveryTowns,
  deliveryWindow,
  eveningWindow,
  windowHours,
} from '../lib/delivery';
import { dayFormat, madridParts, routes, type Lang } from '../lib/i18n';
import { currentBake } from '../lib/store';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
let current: Awaited<ReturnType<typeof currentBake>> | undefined;
if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    /* Shows the weekly rhythm without a date. */
  }
}
const close = current && madridParts(lang, current.deadline);
const [from, to] = deliveryWindow.split('–') as [string, string];
const hours = `${Number(from.split(':')[0])}\u00a0a\u00a0${Number(to.split(':')[0])}\u00a0h`;
// Wednesday's evening round: "de 18 a 20 h".
const evening = windowHours(eveningWindow);
const [eveFrom, eveTo] = eveningWindow.split('–') as [string, string];
const loaf = money(productById('clasica')!.price);
const bananaWhole = money(productById('banana')!.price);
const bananaHalf = money(productById('banana-mitad')!.price);
const croissant = money(productById('croissant')!.price);
const pain = money(productById('pain-au-chocolat')!.price);
const text = {
  es: {
    crumb: 'Pan a domicilio',
    title: `Pan a domicilio en Sant Boi y el Baix Llobregat · ${brand.name}`,
    description: `Pan de masa madre y poolish a domicilio en Sant Boi, Sant Just, Sant Joan Despí, Sant Feliu, Santa Coloma y Sant Vicenç. Miércoles y sábado, envío gratis.`,
    kicker: `A domicilio · miércoles y sábados de ${hours} · miércoles también ${evening}`,
    h1: 'Pan artesano a domicilio, miércoles y sábado.',
    lede: `Reservas durante la semana y el miércoles o el sábado, entre las ${from} y las ${to}, te llevo a casa el pan horneado esa misma mañana. Si a mediodía trabajas, el miércoles también reparto por la tarde, entre las ${eveFrom} y las ${eveTo}. En Sant Boi de Llobregat, Sant Just Desvern, Sant Joan Despí, Sant Feliu de Llobregat, Santa Coloma de Cervelló y Sant Vicenç dels Horts.`,
    whenH: 'Cuándo',
    when: (day: string) =>
      `Los miércoles y los sábados, de ${hours}; los miércoles, también ${evening}. El próximo reparto es el ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Los pedidos se cierran el ${weekday} ${d} a las ${time} o cuando se completa la hornada.`,
    whenFallback: `Los miércoles y los sábados, de ${hours}; los miércoles, también ${evening}. Los pedidos se cierran a las 20:00 del lunes (para el miércoles) o del jueves (para el sábado), o cuando se completa la hornada.`,
    whereH: 'Dónde reparto',
    towns: {
      'sant-boi':
        'Aquí horneo. Reparto a domicilio el miércoles y el sábado y, si lo prefieres, también puedes recogerlo en Sant Boi.',
      'sant-just':
        'Cada miércoles y cada sábado hago la ruta hasta Sant Just Desvern. El pan llega horneado esa misma mañana, todavía con la corteza crujiente.',
      'sant-joan':
        'Sant Joan Despí está al lado de Sant Just: entra en la misma ruta del miércoles y del sábado.',
      'sant-feliu':
        'Reparto a domicilio en Sant Feliu de Llobregat dentro de la misma franja, miércoles y sábado.',
      'santa-coloma':
        'Reparto a domicilio en Santa Coloma de Cervelló dentro de la misma franja, miércoles y sábado.',
      'sant-vicenc':
        'Reparto a domicilio en Sant Vicenç dels Horts dentro de la misma franja, miércoles y sábado.',
    } as Record<string, string>,
    otherH: '¿Vives en otro municipio del Baix Llobregat?',
    other:
      'Desde Cornellà, Molins de Rei o Viladecans, lo recoges en Sant Boi de Llobregat.',
    otherLink: 'Cómo funciona la recogida',
    howH: 'Cómo funciona',
    how: [
      'Reservas en la web, eliges «A domicilio», tu municipio y tu dirección.',
      'Te llega la confirmación por email con tu código. El día antes, un recordatorio.',
      `El miércoles o el sábado, entre las ${from} y las ${to}, te llevo el pedido a casa. Si necesito confirmar algo, te escribo por WhatsApp.`,
      'Pagas al recibirlo. Sin tarjeta ni cuenta. Reservar una vez no te obliga a nada. El Pan fijo es opcional.',
    ],
    priceH: 'Qué cuesta',
    price: `La hogaza de poolish (750–850 g) cuesta ${loaf}; el banana bread, ${bananaWhole} entero o ${bananaHalf} la mitad. En cada hornada también hay croissants (${croissant}) y pains au chocolat (${pain}). El reparto no tiene coste de envío.`,
    absentH: '¿Y si no voy a estar?',
    absent:
      'Responde al email de confirmación cuanto antes con tu código. Si aún estamos a tiempo, libero el pan para otra persona; si no, buscamos juntos otra forma de dártelo.',
    photo: 'El panadero sostiene una hogaza recién horneada y sonríe',
    service: 'Reparto de pan artesano a domicilio',
  },
  ca: {
    crumb: 'Pa a domicili',
    title: `Pa a domicili a Sant Boi i el Baix Llobregat · ${brand.name}`,
    description: `Pa de massa mare i poolish a domicili a Sant Boi, Sant Just, Sant Joan Despí, Sant Feliu, Santa Coloma i Sant Vicenç. Dimecres i dissabte, enviament gratis.`,
    kicker: `A domicili · dimecres i dissabtes de ${hours} · dimecres també ${evening}`,
    h1: 'Pa artesà a domicili, dimecres i dissabte.',
    lede: `Reserves durant la setmana i dimecres o dissabte, entre les ${from} i les ${to}, et porto a casa el pa cuit aquell mateix matí. Si al migdia treballes, el dimecres també reparteixo a la tarda, entre les ${eveFrom} i les ${eveTo}. A Sant Boi de Llobregat, Sant Just Desvern, Sant Joan Despí, Sant Feliu de Llobregat, Santa Coloma de Cervelló i Sant Vicenç dels Horts.`,
    whenH: 'Quan',
    when: (day: string) =>
      `Els dimecres i els dissabtes, de ${hours}; els dimecres, també ${evening}. El proper repartiment és ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Les comandes es tanquen ${weekday} ${d} a les ${time} o quan s’acaba la fornada.`,
    whenFallback: `Els dimecres i els dissabtes, de ${hours}; els dimecres, també ${evening}. Les comandes es tanquen a les 20:00 de dilluns (per a dimecres) o de dijous (per a dissabte), o quan s’acaba la fornada.`,
    whereH: 'On reparteixo',
    towns: {
      'sant-boi':
        'Aquí és on faig el pa. Reparteixo a domicili dimecres i dissabte i, si ho prefereixes, també el pots recollir a Sant Boi.',
      'sant-just':
        'Cada dimecres i cada dissabte faig la ruta fins a Sant Just Desvern. El pa arriba cuit aquell mateix matí, encara amb la crosta cruixent.',
      'sant-joan':
        'Sant Joan Despí és al costat de Sant Just: entra a la mateixa ruta del dimecres i del dissabte.',
      'sant-feliu':
        'Reparteixo a domicili a Sant Feliu de Llobregat dins de la mateixa franja, dimecres i dissabte.',
      'santa-coloma':
        'Reparteixo a domicili a Santa Coloma de Cervelló dins de la mateixa franja, dimecres i dissabte.',
      'sant-vicenc':
        'Reparteixo a domicili a Sant Vicenç dels Horts dins de la mateixa franja, dimecres i dissabte.',
    } as Record<string, string>,
    otherH: 'Vius en un altre municipi del Baix Llobregat?',
    other:
      'Des de Cornellà, Molins de Rei o Viladecans, el reculls a Sant Boi de Llobregat.',
    otherLink: 'Com funciona la recollida',
    howH: 'Com funciona',
    how: [
      'Reserves al web, tries «A domicili», el teu municipi i la teva adreça.',
      'T’arriba la confirmació per correu amb el teu codi. El dia abans, un recordatori.',
      `Dimecres o dissabte, entre les ${from} i les ${to}, et porto la comanda a casa. Si he de confirmar alguna cosa, t’escric per WhatsApp.`,
      'Pagues en rebre’l. Sense targeta ni compte. Reservar una vegada no t’obliga a res. El Pa fix és opcional.',
    ],
    priceH: 'Què costa',
    price: `El pa de poolish (750–850 g) costa ${loaf}; el banana bread, ${bananaWhole} sencer o ${bananaHalf} la meitat. A cada fornada també hi ha croissants (${croissant}) i pains au chocolat (${pain}). El repartiment no té cost d’enviament.`,
    absentH: 'I si no hi seré?',
    absent:
      'Respon el correu de confirmació com més aviat millor amb el teu codi. Si encara som a temps, allibero el pa per a una altra persona; si no, busquem junts una altra manera de fer-te’l arribar.',
    photo: 'El forner sosté un pa acabat de coure i somriu',
    service: 'Repartiment de pa artesà a domicili',
  },
  en: {
    crumb: 'Bread delivery',
    title: `Bread delivery in Sant Boi and the Baix Llobregat · ${brand.name}`,
    description: `Sourdough and poolish bread delivered in Sant Boi, Sant Just, Sant Joan Despí, Sant Feliu, Santa Coloma and Sant Vicenç. Wednesday and Saturday, free delivery.`,
    kicker: `Home delivery · Wednesdays and Saturdays ${from}–${to} · Wednesdays also ${eveFrom}–${eveTo}`,
    h1: 'Artisan bread delivered, Wednesday and Saturday.',
    lede: `You order during the week and on Wednesday or Saturday, between ${from} and ${to}, I bring you bread baked that same morning. If you work at midday, on Wednesdays I also deliver in the evening, between ${eveFrom} and ${eveTo}. In Sant Boi de Llobregat, Sant Just Desvern, Sant Joan Despí, Sant Feliu de Llobregat, Santa Coloma de Cervelló and Sant Vicenç dels Horts.`,
    whenH: 'When',
    when: (day: string) =>
      `Wednesdays and Saturdays, ${from}–${to}; Wednesdays also ${eveFrom}–${eveTo}. The next delivery is on ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Orders close on ${weekday} ${d} at ${time} or when the bake is full.`,
    whenFallback: `Wednesdays and Saturdays, ${from}–${to}; Wednesdays also ${eveFrom}–${eveTo}. Orders close at 20:00 on Monday (for Wednesday) or Thursday (for Saturday), or when the bake is full.`,
    whereH: 'Where I deliver',
    towns: {
      'sant-boi':
        'This is where I make the bread. I deliver on Wednesday and Saturday and, if you prefer, you can also pick it up in Sant Boi.',
      'sant-just':
        'Every Wednesday and Saturday I drive the route to Sant Just Desvern. The bread arrives baked that same morning, its crust still crunchy.',
      'sant-joan':
        'Sant Joan Despí is right next to Sant Just: it’s on the same Wednesday and Saturday route.',
      'sant-feliu':
        'I deliver in Sant Feliu de Llobregat within the same slot, Wednesday and Saturday.',
      'santa-coloma':
        'I deliver in Santa Coloma de Cervelló within the same slot, Wednesday and Saturday.',
      'sant-vicenc':
        'I deliver in Sant Vicenç dels Horts within the same slot, Wednesday and Saturday.',
    } as Record<string, string>,
    otherH: 'Live in another town in the Baix Llobregat?',
    other:
      'From Cornellà, Molins de Rei or Viladecans, you pick it up in Sant Boi de Llobregat.',
    otherLink: 'How pickup works',
    howH: 'How it works',
    how: [
      'Order on the website, choose «Home delivery», your town and your address.',
      'You get the confirmation by email with your code. The day before, a reminder.',
      `On Wednesday or Saturday, between ${from} and ${to}, I bring the order to your home. If I need to confirm anything, I’ll message you on WhatsApp.`,
      'You pay when you get it. No card, no account. Ordering once doesn’t commit you to anything. Weekly bread is optional.',
    ],
    priceH: 'What it costs',
    price: `The poolish loaf (750–850 g) costs ${loaf}; the banana bread, ${bananaWhole} whole or ${bananaHalf} for half. Every bake also has croissants (${croissant}) and pains au chocolat (${pain}). Delivery is free of charge.`,
    absentH: 'What if I won’t be home?',
    absent:
      'Reply to the confirmation email as soon as possible with your code. If there’s still time, I release the bread for someone else; if not, we’ll find another way to get it to you.',
    photo: 'The baker holds a freshly baked loaf and smiles',
    service: 'Artisan bread home delivery',
  },
}[lang];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: text.service,
  serviceType: text.crumb,
  description: text.description,
  provider: {
    '@id': brand.site ? new URL('/#organization', brand.site).href : undefined,
  },
  areaServed: deliveryTowns.map((town) => ({
    '@type': 'City',
    name: town.name,
  })),
  hoursAvailable: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'https://schema.org/Wednesday',
        'https://schema.org/Saturday',
      ],
      opens: from,
      closes: to,
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'https://schema.org/Wednesday',
      opens: eveFrom,
      closes: eveTo,
    },
  ],
};
---

<Article
  lang={lang}
  route="delivery"
  crumb={text.crumb}
  title={text.title}
  description={text.description}
  kicker={text.kicker}
  h1={text.h1}
  lede={text.lede}
  jsonLd={[service]}
>
  <div class="article-grid">
    <div class="prose">
      <h2>{text.whenH}</h2>
      <p>
        {current ? (
          <>
            {text.when(dayFormat(lang, current.pickupDate))}
            {text.whenClose(close!.weekday, close!.day, close!.time)}
          </>
        ) : (
          text.whenFallback
        )}
      </p>

      <h2>{text.whereH}</h2>
      {deliveryTowns.map((town) => (
        <>
          <h3>{town.name}</h3>
          <p>{text.towns[town.id]}</p>
        </>
      ))}
      <h3>{text.otherH}</h3>
      <p>
        {text.other} <a href={routes.pickup[lang]}>{text.otherLink}</a>.
      </p>

      <h2>{text.howH}</h2>
      <ol>
        {text.how.map((step) => (
          <li>{step}</li>
        ))}
      </ol>

      <h2>{text.priceH}</h2>
      <p>{text.price}</p>

      <h2>{text.absentH}</h2>
      <p>{text.absent}</p>
    </div>
    <figure class="article-photo">
      <Photo
        name="person"
        alt={text.photo}
        sizes="(max-width: 860px) calc(100vw - 40px), 40vw"
      />
    </figure>
  </div>
</Article>
