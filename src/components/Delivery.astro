---
import Article from '../layouts/Article.astro';
import Photo from './Photo.astro';
import { brand, isDemo, launchReady, money, productById } from '../lib/config';
import { deliveryTowns, deliveryWindow } from '../lib/delivery';
import { dayFormat, madridParts, routes, type Lang } from '../lib/i18n';
import { currentBake } from '../lib/store';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
let current: Awaited<ReturnType<typeof currentBake>> | undefined;
if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    /* Shows the weekly rhythm without a date. */
  }
}
const close = current && madridParts(lang, current.deadline);
const [from, to] = deliveryWindow.split('–') as [string, string];
const hours = `${Number(from.split(':')[0])}\u00a0a\u00a0${Number(to.split(':')[0])}\u00a0h`;
const loaf = money(productById('clasica')!.price);
const bananaWhole = money(productById('banana')!.price);
const bananaHalf = money(productById('banana-mitad')!.price);
const text = {
  es: {
    crumb: 'Pan a domicilio',
    title: `Pan a domicilio en Sant Boi, Sant Just y Santa Coloma · ${brand.name}`,
    description: `Pan artesano de fermentación lenta a domicilio los sábados de ${hours} en Sant Boi de Llobregat, Sant Just Desvern y Santa Coloma de Cervelló. Reserva online, sin coste de envío; pagas al recibirlo.`,
    kicker: `A domicilio · sábados de ${hours}`,
    h1: 'Pan artesano a domicilio, cada sábado.',
    lede: `Reservas durante la semana y el sábado, entre las ${from} y las ${to}, te llevo a casa el pan horneado esa misma mañana. En Sant Boi de Llobregat, Sant Just Desvern y Santa Coloma de Cervelló.`,
    whenH: 'Cuándo',
    when: (day: string) =>
      `Los sábados, de ${hours}. El próximo reparto es el ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Los pedidos se cierran el ${weekday} ${d} a las ${time} o cuando se completa la hornada.`,
    whenFallback: `Los sábados, de ${hours}. Los pedidos se cierran el jueves a las 20:00 o cuando se completa la hornada.`,
    whereH: 'Dónde reparto',
    towns: {
      'sant-boi':
        'Aquí horneo. Reparto a domicilio el sábado y, si lo prefieres, también puedes recogerlo en Sant Boi.',
      'sant-just':
        'Cada sábado hago la ruta hasta Sant Just Desvern. El pan llega horneado esa misma mañana, todavía con la corteza crujiente.',
      'santa-coloma':
        'Reparto a domicilio en Santa Coloma de Cervelló dentro de la misma franja del sábado.',
    } as Record<string, string>,
    otherH: '¿Vives en otro municipio del Baix Llobregat?',
    other:
      'Desde Cornellà, Sant Joan Despí, Sant Feliu de Llobregat, Sant Vicenç dels Horts o Viladecans, lo recoges en Sant Boi de Llobregat.',
    otherLink: 'Cómo funciona la recogida',
    howH: 'Cómo funciona',
    how: [
      'Reservas en la web, eliges «A domicilio», tu municipio y tu dirección.',
      'Te llega la confirmación por email con tu código. El día antes, un recordatorio.',
      `El sábado, entre las ${from} y las ${to}, te llevo el pedido a casa. Si necesito confirmar algo, te escribo por WhatsApp.`,
      'Pagas al recibirlo. Sin tarjeta, sin cuenta y sin suscripciones.',
    ],
    priceH: 'Qué cuesta',
    price: `La hogaza de poolish (750–850 g) cuesta ${loaf}; el banana bread, ${bananaWhole} entero o ${bananaHalf} la mitad. El reparto no tiene coste de envío.`,
    absentH: '¿Y si no voy a estar?',
    absent:
      'Responde al email de confirmación cuanto antes con tu código. Si aún estamos a tiempo, libero el pan para otra persona; si no, buscamos juntos otra forma de dártelo.',
    photo: 'El panadero sostiene una hogaza recién horneada y sonríe',
    service: 'Reparto de pan artesano a domicilio',
  },
  ca: {
    crumb: 'Pa a domicili',
    title: `Pa a domicili a Sant Boi, Sant Just i Santa Coloma · ${brand.name}`,
    description: `Pa artesà de fermentació lenta a domicili els dissabtes de ${hours} a Sant Boi de Llobregat, Sant Just Desvern i Santa Coloma de Cervelló. Reserva en línia, sense cost d’enviament; pagues en rebre’l.`,
    kicker: `A domicili · dissabtes de ${hours}`,
    h1: 'Pa artesà a domicili, cada dissabte.',
    lede: `Reserves durant la setmana i dissabte, entre les ${from} i les ${to}, et porto a casa el pa cuit aquell mateix matí. A Sant Boi de Llobregat, Sant Just Desvern i Santa Coloma de Cervelló.`,
    whenH: 'Quan',
    when: (day: string) =>
      `Els dissabtes, de ${hours}. El proper repartiment és ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Les comandes es tanquen ${weekday} ${d} a les ${time} o quan s’acaba la fornada.`,
    whenFallback: `Els dissabtes, de ${hours}. Les comandes es tanquen dijous a les 20:00 o quan s’acaba la fornada.`,
    whereH: 'On reparteixo',
    towns: {
      'sant-boi':
        'Aquí és on faig el pa. Reparteixo a domicili dissabte i, si ho prefereixes, també el pots recollir a Sant Boi.',
      'sant-just':
        'Cada dissabte faig la ruta fins a Sant Just Desvern. El pa arriba cuit aquell mateix matí, encara amb la crosta cruixent.',
      'santa-coloma':
        'Reparteixo a domicili a Santa Coloma de Cervelló dins de la mateixa franja de dissabte.',
    } as Record<string, string>,
    otherH: 'Vius en un altre municipi del Baix Llobregat?',
    other:
      'Des de Cornellà, Sant Joan Despí, Sant Feliu de Llobregat, Sant Vicenç dels Horts o Viladecans, el reculls a Sant Boi de Llobregat.',
    otherLink: 'Com funciona la recollida',
    howH: 'Com funciona',
    how: [
      'Reserves al web, tries «A domicili», el teu municipi i la teva adreça.',
      'T’arriba la confirmació per correu amb el teu codi. El dia abans, un recordatori.',
      `Dissabte, entre les ${from} i les ${to}, et porto la comanda a casa. Si he de confirmar alguna cosa, t’escric per WhatsApp.`,
      'Pagues en rebre’l. Sense targeta, sense compte i sense subscripcions.',
    ],
    priceH: 'Què costa',
    price: `El pa de poolish (750–850 g) costa ${loaf}; el banana bread, ${bananaWhole} sencer o ${bananaHalf} la meitat. El repartiment no té cost d’enviament.`,
    absentH: 'I si no hi seré?',
    absent:
      'Respon el correu de confirmació com més aviat millor amb el teu codi. Si encara som a temps, allibero el pa per a una altra persona; si no, busquem junts una altra manera de fer-te’l arribar.',
    photo: 'El forner sosté un pa acabat de coure i somriu',
    service: 'Repartiment de pa artesà a domicili',
  },
}[lang];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: text.service,
  serviceType: text.crumb,
  description: text.description,
  provider: {
    '@id': brand.site ? new URL('/#organization', brand.site).href : undefined,
  },
  areaServed: deliveryTowns.map((town) => ({
    '@type': 'City',
    name: town.name,
  })),
  hoursAvailable: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: 'https://schema.org/Saturday',
    opens: from,
    closes: to,
  },
};
---

<Article
  lang={lang}
  route="delivery"
  crumb={text.crumb}
  title={text.title}
  description={text.description}
  kicker={text.kicker}
  h1={text.h1}
  lede={text.lede}
  jsonLd={[service]}
>
  <div class="article-grid">
    <div class="prose">
      <h2>{text.whenH}</h2>
      <p>
        {current ? (
          <>
            {text.when(dayFormat(lang, current.pickupDate))}
            {text.whenClose(close!.weekday, close!.day, close!.time)}
          </>
        ) : (
          text.whenFallback
        )}
      </p>

      <h2>{text.whereH}</h2>
      {deliveryTowns.map((town) => (
        <>
          <h3>{town.name}</h3>
          <p>{text.towns[town.id]}</p>
        </>
      ))}
      <h3>{text.otherH}</h3>
      <p>
        {text.other} <a href={routes.pickup[lang]}>{text.otherLink}</a>.
      </p>

      <h2>{text.howH}</h2>
      <ol>
        {text.how.map((step) => (
          <li>{step}</li>
        ))}
      </ol>

      <h2>{text.priceH}</h2>
      <p>{text.price}</p>

      <h2>{text.absentH}</h2>
      <p>{text.absent}</p>
    </div>
    <figure class="article-photo">
      <Photo
        name="person"
        alt={text.photo}
        sizes="(max-width: 860px) calc(100vw - 40px), 40vw"
      />
    </figure>
  </div>
</Article>
