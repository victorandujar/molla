---
import Article from '../layouts/Article.astro';
import Photo from './Photo.astro';
import { brand, isDemo, launchReady, money, productById } from '../lib/config';
import {
  deliveryArea,
  deliveryTowns,
  deliveryWindow,
  deliveryZones,
  eveningWindow,
  townsInZone,
  windowHours,
} from '../lib/delivery';
import { dayFormat, madridParts, routes, type Lang } from '../lib/i18n';
import { currentBake } from '../lib/store';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
let current: Awaited<ReturnType<typeof currentBake>> | undefined;
if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    /* Shows the weekly rhythm without a date. */
  }
}
const close = current && madridParts(lang, current.deadline);
const [from, to] = deliveryWindow.split('–') as [string, string];
const hours = `${Number(from.split(':')[0])}\u00a0a\u00a0${Number(to.split(':')[0])}\u00a0h`;
// Wednesday's evening round: "de 18 a 20 h".
const evening = windowHours(eveningWindow);
const [eveFrom, eveTo] = eveningWindow.split('–') as [string, string];
const loaf = money(productById('clasica')!.price);
const bananaWhole = money(productById('banana')!.price);
const bananaHalf = money(productById('banana-mitad')!.price);
const croissant = money(productById('croissant')!.price);
const pain = money(productById('pain-au-chocolat')!.price);
const text = {
  es: {
    crumb: 'Pan a domicilio',
    title: `Pan a domicilio en Sant Boi y el Baix Llobregat · ${brand.name}`,
    description: `Pan de masa madre y poolish a domicilio en ${deliveryArea.es}: Santa Coloma de Cervelló, Sant Boi, Molins de Rei, Gavà, Cornellà, El Prat y más. Miércoles y sábado, envío gratis.`,
    kicker: `A domicilio · miércoles y sábados de ${hours} · miércoles también ${evening}`,
    h1: 'Pan artesano a domicilio, miércoles y sábado.',
    lede: `Reservas durante la semana y el miércoles o el sábado, entre las ${from} y las ${to}, te llevo a casa el pan horneado esa misma mañana. Si a mediodía trabajas, el miércoles también reparto por la tarde, entre las ${eveFrom} y las ${eveTo}. En ${deliveryArea.es}, de Santa Coloma de Cervelló a El Prat.`,
    whenH: 'Cuándo',
    when: (day: string) =>
      `Los miércoles y los sábados, de ${hours}; los miércoles, también ${evening}. El próximo reparto es el ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Los pedidos se cierran el ${weekday} ${d} a las ${time} o cuando se completa la hornada.`,
    whenFallback: `Los miércoles y los sábados, de ${hours}; los miércoles, también ${evening}. Los pedidos se cierran a las 20:00 del lunes (para el miércoles) o del jueves (para el sábado), o cuando se completa la hornada.`,
    whereKicker: 'Zona de reparto',
    whereH: 'Dónde reparto',
    whereIntro: `Molla es un obrador de proximidad: el pan viaja poco. Lo horneo por la mañana y lo llevo a casa por el Baix Llobregat. Hago entregas a domicilio en estas ${deliveryTowns.length} poblaciones, todas con las mismas condiciones y sin coste de envío.`,
    zone: 'Zona',
    zones: {
      1: [
        'Zona de proximidad',
        'Los pueblos que rodean Santa Coloma de Cervelló, el corazón de la ruta.',
      ],
      2: [
        'Baix Llobregat cercano',
        'Río arriba y hacia la montaña, de Molins de Rei a Gavà.',
      ],
      3: [
        'Zona de reparto ampliada',
        'Hasta el final de la ruta, de El Papiol a El Prat.',
      ],
    },
    findLabel: '¿Llego a tu casa? Busca tu población',
    findPlaceholder: 'Por ejemplo, Gavà',
    found: (town: string, zone: number | string) =>
      `Sí, llego a ${town} (zona ${zone}). Te lo llevo el miércoles o el sábado, sin coste de envío.`,
    notFound: (q: string) =>
      `Todavía no reparto en «${q}». Puedes recogerlo en Sant Boi de Llobregat.`,
    same: 'Mismas condiciones en todas las poblaciones: miércoles y sábado, las mismas franjas y sin coste de envío.',
    otherH: '¿No ves tu población?',
    other:
      'Si vives fuera de la zona de reparto, lo recoges en Sant Boi de Llobregat.',
    otherLink: 'Cómo funciona la recogida',
    howH: 'Cómo funciona',
    how: [
      'Reservas en la web, eliges «A domicilio», tu municipio y tu dirección.',
      'Te llega la confirmación por email con tu código. El día antes, un recordatorio.',
      `El miércoles o el sábado, entre las ${from} y las ${to}, te llevo el pedido a casa. Si necesito confirmar algo, te escribo por WhatsApp.`,
      'Pagas al recibirlo. Sin tarjeta ni cuenta. Reservar una vez no te obliga a nada. El Pan fijo es opcional.',
    ],
    priceH: 'Qué cuesta',
    price: `La hogaza de poolish (750–850 g) cuesta ${loaf}; el banana bread, ${bananaWhole} entero o ${bananaHalf} la mitad. En cada hornada también hay croissants (${croissant}) y pains au chocolat (${pain}). El reparto no tiene coste de envío.`,
    absentH: '¿Y si no voy a estar?',
    absent:
      'Responde al email de confirmación cuanto antes con tu código. Si aún estamos a tiempo, libero el pan para otra persona; si no, buscamos juntos otra forma de dártelo.',
    photo: 'El panadero sostiene una hogaza recién horneada y sonríe',
    service: 'Reparto de pan artesano a domicilio',
  },
  ca: {
    crumb: 'Pa a domicili',
    title: `Pa a domicili a Sant Boi i el Baix Llobregat · ${brand.name}`,
    description: `Pa de massa mare i poolish a domicili a ${deliveryArea.ca}: Santa Coloma de Cervelló, Sant Boi, Molins de Rei, Gavà, Cornellà, el Prat i més. Dimecres i dissabte, enviament gratis.`,
    kicker: `A domicili · dimecres i dissabtes de ${hours} · dimecres també ${evening}`,
    h1: 'Pa artesà a domicili, dimecres i dissabte.',
    lede: `Reserves durant la setmana i dimecres o dissabte, entre les ${from} i les ${to}, et porto a casa el pa cuit aquell mateix matí. Si al migdia treballes, el dimecres també reparteixo a la tarda, entre les ${eveFrom} i les ${eveTo}. A ${deliveryArea.ca}, de Santa Coloma de Cervelló al Prat.`,
    whenH: 'Quan',
    when: (day: string) =>
      `Els dimecres i els dissabtes, de ${hours}; els dimecres, també ${evening}. El proper repartiment és ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Les comandes es tanquen ${weekday} ${d} a les ${time} o quan s’acaba la fornada.`,
    whenFallback: `Els dimecres i els dissabtes, de ${hours}; els dimecres, també ${evening}. Les comandes es tanquen a les 20:00 de dilluns (per a dimecres) o de dijous (per a dissabte), o quan s’acaba la fornada.`,
    whereKicker: 'Zona de repartiment',
    whereH: 'On reparteixo',
    whereIntro: `Molla és un obrador de proximitat: el pa viatja poc. El faig al matí i el porto a casa pel Baix Llobregat. Faig entregues a domicili en aquestes ${deliveryTowns.length} poblacions, totes amb les mateixes condicions i sense cost d’enviament.`,
    zone: 'Zona',
    zones: {
      1: [
        'Zona de proximitat',
        'Els pobles que envolten Santa Coloma de Cervelló, el cor de la ruta.',
      ],
      2: [
        'Baix Llobregat proper',
        'Riu amunt i cap a la muntanya, de Molins de Rei a Gavà.',
      ],
      3: [
        'Zona de repartiment ampliada',
        'Fins al final de la ruta, del Papiol al Prat.',
      ],
    },
    findLabel: 'Arribo a casa teva? Busca la teva població',
    findPlaceholder: 'Per exemple, Gavà',
    found: (town: string, zone: number | string) =>
      `Sí, arribo a ${town} (zona ${zone}). Te’l porto dimecres o dissabte, sense cost d’enviament.`,
    notFound: (q: string) =>
      `Encara no reparteixo a «${q}». El pots recollir a Sant Boi de Llobregat.`,
    same: 'Mateixes condicions a totes les poblacions: dimecres i dissabte, les mateixes franges i sense cost d’enviament.',
    otherH: 'No hi veus la teva població?',
    other:
      'Si vius fora de la zona de repartiment, el reculls a Sant Boi de Llobregat.',
    otherLink: 'Com funciona la recollida',
    howH: 'Com funciona',
    how: [
      'Reserves al web, tries «A domicili», el teu municipi i la teva adreça.',
      'T’arriba la confirmació per correu amb el teu codi. El dia abans, un recordatori.',
      `Dimecres o dissabte, entre les ${from} i les ${to}, et porto la comanda a casa. Si he de confirmar alguna cosa, t’escric per WhatsApp.`,
      'Pagues en rebre’l. Sense targeta ni compte. Reservar una vegada no t’obliga a res. El Pa fix és opcional.',
    ],
    priceH: 'Què costa',
    price: `El pa de poolish (750–850 g) costa ${loaf}; el banana bread, ${bananaWhole} sencer o ${bananaHalf} la meitat. A cada fornada també hi ha croissants (${croissant}) i pains au chocolat (${pain}). El repartiment no té cost d’enviament.`,
    absentH: 'I si no hi seré?',
    absent:
      'Respon el correu de confirmació com més aviat millor amb el teu codi. Si encara som a temps, allibero el pa per a una altra persona; si no, busquem junts una altra manera de fer-te’l arribar.',
    photo: 'El forner sosté un pa acabat de coure i somriu',
    service: 'Repartiment de pa artesà a domicili',
  },
  en: {
    crumb: 'Bread delivery',
    title: `Bread delivery in Sant Boi and the Baix Llobregat · ${brand.name}`,
    description: `Sourdough and poolish bread delivered in ${deliveryArea.en}: Santa Coloma de Cervelló, Sant Boi, Molins de Rei, Gavà, Cornellà, El Prat and more. Wednesday and Saturday, free delivery.`,
    kicker: `Home delivery · Wednesdays and Saturdays ${from}–${to} · Wednesdays also ${eveFrom}–${eveTo}`,
    h1: 'Artisan bread delivered, Wednesday and Saturday.',
    lede: `You order during the week and on Wednesday or Saturday, between ${from} and ${to}, I bring you bread baked that same morning. If you work at midday, on Wednesdays I also deliver in the evening, between ${eveFrom} and ${eveTo}. In ${deliveryArea.en}, from Santa Coloma de Cervelló to El Prat.`,
    whenH: 'When',
    when: (day: string) =>
      `Wednesdays and Saturdays, ${from}–${to}; Wednesdays also ${eveFrom}–${eveTo}. The next delivery is on ${day}.`,
    whenClose: (weekday: string, d: string, time: string) =>
      ` Orders close on ${weekday} ${d} at ${time} or when the bake is full.`,
    whenFallback: `Wednesdays and Saturdays, ${from}–${to}; Wednesdays also ${eveFrom}–${eveTo}. Orders close at 20:00 on Monday (for Wednesday) or Thursday (for Saturday), or when the bake is full.`,
    whereKicker: 'Delivery area',
    whereH: 'Where I deliver',
    whereIntro: `Molla is a neighbourhood bakery: the bread doesn’t travel far. I bake it in the morning and bring it to your door across the Baix Llobregat. I deliver to these ${deliveryTowns.length} towns, all on the same terms and free of charge.`,
    zone: 'Zone',
    zones: {
      1: [
        'Close to home',
        'The towns around Santa Coloma de Cervelló, the heart of the route.',
      ],
      2: [
        'Nearby Baix Llobregat',
        'Up the river and towards the hills, from Molins de Rei to Gavà.',
      ],
      3: [
        'Wider delivery area',
        'To the far end of the route, from El Papiol to El Prat.',
      ],
    },
    findLabel: 'Do I deliver to you? Find your town',
    findPlaceholder: 'For example, Gavà',
    found: (town: string, zone: number | string) =>
      `Yes, I deliver to ${town} (zone ${zone}). I’ll bring it on Wednesday or Saturday, free of charge.`,
    notFound: (q: string) =>
      `I don’t deliver to “${q}” yet. You can pick it up in Sant Boi de Llobregat.`,
    same: 'Same terms in every town: Wednesday and Saturday, the same slots and no delivery fee.',
    otherH: 'Can’t see your town?',
    other:
      'If you live outside the delivery area, you pick it up in Sant Boi de Llobregat.',
    otherLink: 'How pickup works',
    howH: 'How it works',
    how: [
      'Order on the website, choose «Home delivery», your town and your address.',
      'You get the confirmation by email with your code. The day before, a reminder.',
      `On Wednesday or Saturday, between ${from} and ${to}, I bring the order to your home. If I need to confirm anything, I’ll message you on WhatsApp.`,
      'You pay when you get it. No card, no account. Ordering once doesn’t commit you to anything. Weekly bread is optional.',
    ],
    priceH: 'What it costs',
    price: `The poolish loaf (750–850 g) costs ${loaf}; the banana bread, ${bananaWhole} whole or ${bananaHalf} for half. Every bake also has croissants (${croissant}) and pains au chocolat (${pain}). Delivery is free of charge.`,
    absentH: 'What if I won’t be home?',
    absent:
      'Reply to the confirmation email as soon as possible with your code. If there’s still time, I release the bread for someone else; if not, we’ll find another way to get it to you.',
    photo: 'The baker holds a freshly baked loaf and smiles',
    service: 'Artisan bread home delivery',
  },
}[lang];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: text.service,
  serviceType: text.crumb,
  description: text.description,
  provider: {
    '@id': brand.site ? new URL('/#organization', brand.site).href : undefined,
  },
  areaServed: deliveryTowns.map((town) => ({
    '@type': 'City',
    name: town.name,
  })),
  hoursAvailable: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'https://schema.org/Wednesday',
        'https://schema.org/Saturday',
      ],
      opens: from,
      closes: to,
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'https://schema.org/Wednesday',
      opens: eveFrom,
      closes: eveTo,
    },
  ],
};
---

<Article
  lang={lang}
  route="delivery"
  crumb={text.crumb}
  title={text.title}
  description={text.description}
  kicker={text.kicker}
  h1={text.h1}
  lede={text.lede}
  jsonLd={[service]}
>
  <section class="zones" aria-labelledby="zonas">
    <div class="zones-head">
      <p class="kicker">{text.whereKicker}</p>
      <h2 id="zonas">{text.whereH}</h2>
      <p class="zones-intro">{text.whereIntro}</p>
      <div class="zones-find" data-zones-find hidden>
        <label for="zones-q">{text.findLabel}</label>
        <input
          id="zones-q"
          type="search"
          autocomplete="address-level2"
          placeholder={text.findPlaceholder}
          aria-describedby="zones-answer"
        />
        <p
          id="zones-answer"
          class="zones-answer"
          aria-live="polite"
          data-found={text.found('{town}', '{zone}')}
          data-not-found={text.notFound('{q}')}
        ></p>
      </div>
    </div>
    <ol class="zones-grid">
      {deliveryZones.map((zone) => (
        <li class={`zone zone-${zone}`} data-zone={zone}>
          <p class="zone-num">
            <span>
              {text.zone} {zone}
            </span>
            <svg viewBox="0 0 40 40" aria-hidden="true" class="zone-rings">
              {[6, 12, 18].map((radius, i) => (
                <circle
                  cx="20"
                  cy="20"
                  r={radius}
                  class={i < zone ? 'is-on' : undefined}
                />
              ))}
            </svg>
          </p>
          <h3>{text.zones[zone][0]}</h3>
          <p class="zone-note">{text.zones[zone][1]}</p>
          <ul class="zone-towns">
            {townsInZone(zone).map((town) => (
              <li data-town={town.name}>{town.name}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <div class="zones-foot">
      <p>{text.same}</p>
      <p>
        <strong>{text.otherH}</strong> {text.other}{' '}
        <a href={routes.pickup[lang]}>{text.otherLink}</a>.
      </p>
    </div>
  </section>

  <div class="article-grid">
    <div class="prose">
      <h2>{text.whenH}</h2>
      <p>
        {current ? (
          <>
            {text.when(dayFormat(lang, current.pickupDate))}
            {text.whenClose(close!.weekday, close!.day, close!.time)}
          </>
        ) : (
          text.whenFallback
        )}
      </p>

      <h2>{text.howH}</h2>
      <ol>
        {text.how.map((step) => (
          <li>{step}</li>
        ))}
      </ol>

      <h2>{text.priceH}</h2>
      <p>{text.price}</p>

      <h2>{text.absentH}</h2>
      <p>{text.absent}</p>
    </div>
    <figure class="article-photo">
      <Photo
        name="person"
        alt={text.photo}
        sizes="(max-width: 860px) calc(100vw - 40px), 40vw"
      />
    </figure>
  </div>
</Article>

<script>
  // "Do I deliver to you?": type a town, see whether it's on the route.
  // Accents, case and "de Llobregat" don't matter.
  const norm = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[’'·.-]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  const box = document.querySelector<HTMLElement>('[data-zones-find]');
  const input = box?.querySelector('input');
  const answer = box?.querySelector<HTMLElement>('.zones-answer');
  const towns = [...document.querySelectorAll<HTMLElement>('[data-town]')];
  if (box && input && answer) {
    box.hidden = false;
    input.addEventListener('input', () => {
      const q = norm(input.value);
      const hits = towns.filter(
        (li) => q.length >= 2 && norm(li.dataset.town!).includes(q),
      );
      for (const li of towns)
        li.classList.toggle('is-match', hits.includes(li));
      // "Sant" matches a dozen towns: highlight them and wait for more.
      // "Cervelló" is also inside two longer names: an exact name wins.
      const first =
        hits.find((li) => norm(li.dataset.town!) === q) ??
        (hits.length === 1 ? hits[0] : undefined);
      const none = !hits.length && q.length >= 3;
      answer.classList.toggle('is-yes', !!first);
      answer.classList.toggle('is-no', none);
      if (first) {
        const zone = first.closest<HTMLElement>('[data-zone]')!.dataset.zone!;
        answer.textContent = answer.dataset
          .found!.replace('{town}', first.dataset.town!)
          .replace('{zone}', zone);
      } else if (none) {
        answer.textContent = answer.dataset.notFound!.replace(
          '{q}',
          input.value.trim(),
        );
      } else {
        answer.textContent = '';
      }
    });
  }
</script>
