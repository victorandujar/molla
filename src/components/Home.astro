              <input
                name="website"
                aria-label={t.waitlist.honey}
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <label class="check">
              <input
                type="checkbox"
                name="consent"
                value="yes"
                required
                disabled={!canSubmit}
              />
              <span>
                {t.waitlist.consentA}{' '}
                <a href={routes.privacy[lang]}>{t.waitlist.consentLink}</a>.
              </span>
            </label>
            {(brand.whatsappChannel || whatsappNotify) && (
              <a
                class="text-link"
                data-event={
                  brand.whatsappChannel ? 'click_channel' : 'click_whatsapp'
                }
                data-place="waitlist"
                href={brand.whatsappChannel || whatsappNotify}
                target="_blank"
                rel="noopener noreferrer"
              >
                {brand.whatsappChannel
                  ? t.waitlist.channelCta
                  : t.waitlist.whatsapp}{' '}
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {!canSubmit && <p class="form-footnote">{t.waitlist.disabled}</p>}
            {isDemo && <p class="form-footnote">{t.waitlist.demo}</p>}
            <p class="form-error" role="alert" tabindex="-1" hidden></p>
            <p
              class="waitlist-success"
              role="status"
              data-direct={t.waitlist.successDirect}
              hidden
            >
              {t.waitlist.success}
            </p>
            <button class="go" type="submit" disabled={!canSubmit}>
              {t.waitlist.button} <span aria-hidden="true">→</span>
            </button>
          </form>
        )}
      </div>
    </section>
  </main>

  <!-- La bossa: apareix quan hi ha alguna cosa a la comanda -->
  <div
    class="order-pill"
    role="navigation"
    aria-label={t.mobile.label}
    data-pill
    data-open={open ? 'true' : 'false'}
  >
    <span class="pill-badge" data-pill-count aria-hidden="true">
      0
    </span>
    <span class="pill-text">
      <strong data-pill-title>{t.catalog.pill}</strong>
      <small data-pill-items>
        {t.mobile.loaf} {short(loaf.price)} · {pickupWeekday || pickupDay}
      </small>
    </span>
    <span class="pill-total" data-pill-total hidden></span>
    <a
      class="button button-orange"
      href={orderHref}
      data-pill-cta
      data-done={open ? t.catalog.pillDone : undefined}
    >
      {open ? t.catalog.pillCta : t.mobile.notify}
    </a>
  </div>
</Base>

<script>
  import '../lib/experience';
</script>
