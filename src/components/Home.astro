---
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import Sticker from './Sticker.astro';
import {
  brand,
  bake,
  money,
  isDemo,
  launchReady,
  productById,
  PASTRY_MAX_PER_ORDER,
  standingVoucher,
  googleReviews,
} from '../lib/config';
import { ui, routes, dayFormat, type Lang } from '../lib/i18n';
import { currentBake } from '../lib/store';
import { bakeState, pastryBake, publicStock } from '../lib/domain';
import { deliveryTowns } from '../lib/delivery';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
let current = { ...bake, reserved: 0, bananaReserved: 0, pastryReserved: 0 };
let unavailable = false;
if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    unavailable = true;
  }
}
const state = unavailable
  ? 'CLOSED'
  : isDemo || launchReady
    ? bakeState(current, current.reserved)
    : 'UPCOMING';
const open = state === 'OPEN';
const statusLabel = t.status[state];
const canSubmit = isDemo || launchReady;
const loaf = productById('clasica')!;
const bananaWhole = productById('banana')!;
const bananaHalf = productById('banana-mitad')!;
// Levels, not counts: the page never says how many are left.
const stock = publicStock(current);
const stockText = (k: 'bread' | 'banana' | 'pastry') =>
  t.catalog.stock[k][stock[k].level];
const bananaMax = stock.banana.max;
const croissant = productById('croissant')!;
const pain = productById('pain-au-chocolat')!;
// Pastries are baked for Saturday only: the Wednesday bake shows them, but
// they cannot be added until Saturday's bake opens.
const pastryDay = unavailable || pastryBake(current.pickupDate);
const pastryPool = pastryDay ? stock.pastry.max : 0;
const pastryMax = Math.min(PASTRY_MAX_PER_ORDER, pastryPool);
const pastries = [
  {
    key: 'croissant',
    product: croissant,
    name: t.catalog.croissant,
    text: t.pastry.croissantText,
  },
  {
    key: 'pain',
    product: pain,
    name: t.catalog.pain,
    text: t.pastry.painText,
  },
] as const;
// Combina Molla: three suggested pairings, priced as the sum of their pieces
// (no discount). They fill the same order fields as the single products, and
// need Saturday's bake because each one carries pastries.
const combos = (
  [
    ['desayuno', 'croissant', { loaf: 1, croissant: 1 }],
    ['capricho', 'pastries', { loaf: 1, pain: 1 }],
    ['compartir', 'loaves', { loaf: 2, croissant: 2 }],
  ] as const
).map(([id, photo, items]) => {
  const n = { croissant: 0, pain: 0, ...items };
  return {
    id,
    photo,
    items: n,
    name: t.combos.items[id],
    lines: [
      t.catalog.loaves(n.loaf),
      n.croissant && t.catalog.croissants(n.croissant),
      n.pain && t.catalog.pains(n.pain),
    ]
      .filter(Boolean)
      .join(' + '),
    price:
      n.loaf * loaf.price + n.croissant * croissant.price + n.pain * pain.price,
    fits:
      n.loaf <= stock.bread.max &&
      n.croissant + n.pain <= pastryPool &&
      Math.max(n.croissant, n.pain) <= pastryMax,
  };
});
// Without the database the configured bake is only a placeholder: never show its date.
const pickupDay = unavailable
  ? t.bake.dateSoon
  : dayFormat(lang, current.pickupDate);
const orderHref = open ? '#reserva' : '#avisame';
// Prices in the flyer's shorthand: "5€", "8€".
const short = (cents: number) =>
  cents % 100 ? money(cents) : `${cents / 100}€`;
// "2,20€": the flyer's shorthand also for prices with cents.
const tight = (cents: number) =>
  `${(cents / 100).toFixed(2).replace('.', ',')}€`;
const pad = (n: number | string) => String(n).padStart(2, '0');
// Booking by WhatsApp with the message half written: for neighbours who
// prefer a chat to a form.
const whatsappBook = brand.whatsapp
  ? `https://wa.me/${brand.whatsapp}?text=${encodeURIComponent(t.reserve.whatsappText(pickupDay))}`
  : '';
const abs = (path: string) =>
  brand.site ? new URL(path, brand.site).href : undefined;
const offer = (price: number, available: boolean) => ({
  '@type': 'Offer',
  url: abs(`${routes.home[lang]}#carta`),
  price: (price / 100).toFixed(2),
  priceCurrency: 'EUR',
  availability: available
    ? 'https://schema.org/InStock'
    : 'https://schema.org/OutOfStock',
  availableDeliveryMethod: [
    'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
    'http://purl.org/goodrelations/v1#DeliveryModePickUp',
  ],
  areaServed: [
    ...deliveryTowns.map((town) => ({ '@type': 'City', name: town.name })),
    { '@type': 'AdministrativeArea', name: 'Baix Llobregat' },
  ],
  seller: { '@id': abs('/#organization') },
});
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: t.loaf.name,
    description: `${t.loaf.fermentationValue}. ${t.loaf.ingredientsValue}`,
    image: [abs('/images/loaves-1100.webp'), abs('/images/crumb-1100.webp')],
    brand: { '@type': 'Brand', name: brand.name },
    weight: {
      '@type': 'QuantitativeValue',
      minValue: 750,
      maxValue: 850,
      unitCode: 'GRM',
    },
    offers: offer(loaf.price, open),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${t.banana.h2a} ${t.banana.h2b.replace(/\.$/, '')}`,
    description: `${t.banana.p} ${t.banana.ingredientsValue}`,
    image: [abs('/images/banana-1100.webp')],
    brand: { '@type': 'Brand', name: brand.name },
    offers: [
      {
        ...offer(bananaWhole.price, open && bananaMax >= 2),
        name: t.catalog.bananaWhole,
      },
      {
        ...offer(bananaHalf.price, open && bananaMax >= 1),
        name: t.catalog.bananaHalf,
      },
    ],
  },
  ...pastries.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description: `${p.text} ${t.pastry.ingredients}`,
    image: [abs('/images/pastries-1100.webp')],
    brand: { '@type': 'Brand', name: brand.name },
    offers: offer(p.product.price, open && pastryDay && pastryPool > 0),
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: t.faq.items.map(([q, a]) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Base lang={lang} route="home" jsonLd={jsonLd}>
  <main id="contenido">
    <!-- 1 · Portada: el flyer. El pan abierto en las manos de mi madre, en cobalto -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap mono-bar hero-bar hero-in" style="--i:0">
        <span>{t.ed.bar}</span>
        <span>
          {t.bake.number} Nº {pad(current.number)} · Baix Llobregat
        </span>
      </div>
      <div class="wrap hero-grid">
        <h1 id="hero-title" class="hero-title">
          <span class="hero-mask">
            <span class="hero-line" style="--i:0">
              {t.hero.h1a}
            </span>
          </span>{' '}
          <span class="hero-mask">
            <span class="hero-line hero-orange" style="--i:1">
              {t.hero.h1b}.
            </span>
          </span>
        </h1>
        <figure class="hero-photo" data-hero-photo>
          <div class="hero-photo-frame">
            <Photo
              name="crumb2"
              alt={t.hero.photos[1]!}
              eager
              sizes="(max-width: 960px) calc(100vw - 40px), 56vw"
            />
            <span class="hero-logo" aria-hidden="true">
              molla<span>.</span>
            </span>
          </div>
          <figcaption class="fig-bar">
            <span>{t.ed.fig}</span>
            <span>{t.ed.ferment}</span>
          </figcaption>
        </figure>
        <div class="hero-info">
          <p class="hero-lede hero-in" style="--i:3">
            {t.hero.short}
          </p>
          <div
            id="hornada"
            class="hero-bake hero-in"
            style="--i:4"
            data-state={state}
            data-event-view="view_current_bake"
            aria-labelledby="bake-title"
            role="region"
          >
            <div class="stub-row">
              <span class="status">
                <span class="status-dot" aria-hidden="true"></span>
                <span data-bake-label>{statusLabel}</span>
              </span>
              <span class="stub-number">
                {t.bake.number} {current.number}
              </span>
            </div>
            <h2 id="bake-title" class="stub-day">
              {pickupDay}
            </h2>
            <p class="stub-deadline">
              {open
                ? t.bake.open(current.deadline)
                : state === 'UPCOMING'
                  ? t.bake.upcoming
                  : t.bake.closed}
            </p>
            {open && (
              <p
                class="stub-countdown"
                data-countdown={current.deadline}
                data-countdown-label={t.bake.closesIn}
                hidden
              ></p>
            )}
            {unavailable && (
              <p role="status" class="stub-deadline">
                {t.bake.unavailable}
              </p>
            )}
            <p
              class="stub-count"
              data-stock="bread"
              data-level={stock.bread.level}
              hidden={!open || stock.bread.level !== 'low'}
            >
              {t.catalog.stock.bread.low}
            </p>
            <a
              class="button button-orange full stub-cta"
              href={open ? '#carta' : '#avisame'}
              data-bake-cta
            >
              {open ? t.bake.ctaOpen : t.bake.ctaClosed}
              <span class="button-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <ul class="hero-proof hero-in" style="--i:5">
            <li>
              <a href="#resenas">
                <span class="hero-stars" aria-hidden="true">
                  ★★★★★
                </span>
                {googleReviews.score} · {t.reviews.count(googleReviews.count)}
              </a>
            </li>
            {t.hero.proof.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- La cinta: palabras del obrador que corren con el scroll -->
    <div class="marquee" aria-hidden="true" data-marquee>
      {[0, 1].map((row) => (
        <div class:list={['marquee-row', { 'marquee-reverse': row === 1 }]}>
          {[0, 1].map(() => (
            <span class="marquee-track">
              {[...t.hero.keywords, ...t.hero.keywords].map((w, i) => (
                <span class:list={['marquee-word', { outline: (i + row) % 2 }]}>
                  {w}
                  <span class="star">✷</span>
                </span>
              ))}
            </span>
          ))}
        </div>
      ))}
    </div>

    <!-- 3 · La carta: tres piezas, la foto manda y el botón está a mano -->
    <section
      id="carta"
      class="catalog"
      aria-labelledby="catalog-title"
      data-event-view="view_product"
    >
      <div class="wrap">
        <div class="mono-bar" data-bar>
          <span>Nº 01 · {t.catalog.kicker}</span>
          <span>{t.ed.menuBar}</span>
        </div>
        <h2 id="catalog-title" class="catalog-title" data-split>
          {t.catalog.h2a} <em>{t.catalog.h2b}</em>
        </h2>

        <div class="menu">
          <article class="dish dish-loaf" aria-labelledby="loaf-title">
            <div class="dish-media">
              <figure class="dish-photo" data-wipe>
                <Photo
                  name="loaves"
                  alt={t.loaf.alt}
                  sizes="(max-width: 960px) calc(100vw - 40px), 56vw"
                />
              </figure>
              <figure class="dish-inset" data-parallax="-0.08">
                <Photo
                  name="slice"
                  alt={t.loaf.altSlice}
                  sizes="(max-width: 960px) 50vw, 22vw"
                />
              </figure>
            </div>
            <div class="dish-info" data-reveal>
              <p class="dish-index">
                <span>01</span>
                {t.loaf.kicker}
              </p>
              <h3 id="loaf-title">{t.loaf.name}</h3>
              <p class="dish-desc">{t.loaf.fermentationValue}.</p>
              <p class="dish-price">
                <span class="outline-price" aria-hidden="true">
                  {short(loaf.price)}
                </span>
                <strong class="visually-hidden">{money(loaf.price)}</strong>
                <span>{loaf.weight}</span>
              </p>
              {open ? (
                <div class="dish-buy" data-buy="loaf">
                  <button type="button" class="button" data-add="loaf">
                    {t.catalog.add}
                    <span class="button-plus" aria-hidden="true">
                      +
                    </span>
                  </button>
                  <div class="mini-stepper" data-mini="loaf" hidden>
                    <button
                      type="button"
                      data-sub="loaf"
                      aria-label={t.reserve.less}
                    >
                      −
                    </button>
                    <output data-count="loaf" aria-live="polite"></output>
                    <button
                      type="button"
                      data-add="loaf"
                      aria-label={t.reserve.more}
                    >
                      +
                    </button>
                  </div>
                </div>
              ) : (
                <a class="button button-ghost" href="#avisame">
                  {t.loaf.notify}
                </a>
              )}
              <details class="dish-more">
                <summary>{t.catalog.details}</summary>
                <dl class="spec">
                  <div>
                    <dt>{t.loaf.ingredients}</dt>
                    <dd>{t.loaf.ingredientsValue}</dd>
                  </div>
                  <div>
                    <dt>{t.loaf.allergens}</dt>
                    <dd>{t.loaf.allergensValue}</dd>
                  </div>
                  <div>
                    <dt>{t.loaf.keeps}</dt>
                    <dd>{t.loaf.keepsValue}</dd>
                  </div>
                </dl>
              </details>
            </div>
          </article>

          <!-- El banana bread, como el reel: fondo oscuro y precios en cursiva -->
          <article class="card card-banana" aria-labelledby="banana-title">
            <figure class="card-photo" data-wipe>
              <Photo
                name="banana"
                alt={t.banana.alt}
                sizes="(max-width: 960px) calc(100vw - 40px), 44vw"
              />
            </figure>
            <div class="card-body" data-reveal>
              <p class="dish-index">
                <span>02</span>
                {t.banana.kicker}
              </p>
              <h3 id="banana-title">
                <span class="serif-it">{t.banana.h2a}</span>{' '}
                <em>{t.banana.h2b}</em>
              </h3>
              <p class="card-desc">{t.banana.short}</p>
              <fieldset class="size-choice menu-choice" disabled={!open}>
                <legend class="visually-hidden">{t.catalog.size}</legend>
                <label>
                  <input type="radio" name="banana-size" value="2" checked />
                  <span>
                    <strong>{t.ed.whole}</strong>
                    <i class="leader" aria-hidden="true"></i>
                    <em>{short(bananaWhole.price)}</em>
                  </span>
                </label>
                <label>
                  <input type="radio" name="banana-size" value="1" />
                  <span>
                    <strong>{t.ed.half}</strong>
                    <i class="leader" aria-hidden="true"></i>
                    <em>{short(bananaHalf.price)}</em>
                  </span>
                </label>
              </fieldset>
              <p
                class="dish-stock"
                data-stock="banana"
                data-level={stock.banana.level}
                hidden={open && !stockText('banana')}
              >
                {open ? stockText('banana') : t.catalog.closed}
              </p>
              {open ? (
                <div class="dish-buy" data-buy="banana">
                  <button
                    type="button"
                    class="button button-orange"
                    data-add="banana"
                    disabled={bananaMax === 0}
                  >
                    {t.catalog.add}
                    <span class="button-plus" aria-hidden="true">
                      +
                    </span>
                  </button>
                  <div class="mini-stepper" data-mini="banana" hidden>
                    <button
                      type="button"
                      data-sub="banana"
                      aria-label={t.reserve.bananaLess}
                    >
                      −
                    </button>
                    <output data-count="banana" aria-live="polite"></output>
                    <button
                      type="button"
                      data-add="banana"
                      data-halves="1"
                      aria-label={t.reserve.bananaMore}
                    >
                      +
                    </button>
                  </div>
                </div>
              ) : (
                <a class="button button-light" href="#avisame">
                  {t.banana.notify}
                </a>
              )}
              <details class="dish-more">
                <summary>{t.catalog.details}</summary>
                <dl class="spec">
                  <div>
                    <dt>{t.loaf.ingredients}</dt>
                    <dd>{t.banana.ingredientsValue}</dd>
                  </div>
                  <div>
                    <dt>{t.loaf.allergens}</dt>
                    <dd>{t.banana.allergensValue}</dd>
                  </div>
                </dl>
              </details>
            </div>
          </article>

          <!-- Brioixeria: per unitats, amb cupo compartit, només dissabte -->
          <article
            id="bolleria"
            class="card card-pastry"
            aria-labelledby="pastry-title"
          >
            <figure class="card-photo" data-wipe>
              <Photo
                name="pastries"
                alt={t.pastry.alt}
                sizes="(max-width: 960px) calc(100vw - 40px), 44vw"
              />
              <span class="card-tag">{t.pastry.tag}</span>
            </figure>
            <div class="card-body" data-reveal>
              <p class="dish-index">
                <span>03</span>
                {t.pastry.kicker}
              </p>
              <h3 id="pastry-title" class="visually-hidden">
                {t.pastry.kicker}
              </h3>
              <p class="card-desc">{t.pastry.short}</p>
              <ul class="pastry-list">
                {pastries.map((p) => (
                  <li class="pastry-item">
                    <div class="pastry-name">
                      <h4>{p.name}</h4>
                      <p>{p.text}</p>
                    </div>
                    <p class="pastry-price">
                      <span aria-hidden="true">{tight(p.product.price)}</span>
                      <span class="visually-hidden">
                        {money(p.product.price)} · {t.pastry.unit}
                      </span>
                    </p>
                    {open && pastryDay ? (
                      <div class="dish-buy pastry-buy" data-buy={p.key}>
                        <button
                          type="button"
                          class="button button-orange"
                          data-add={p.key}
                          disabled={pastryMax === 0}
                          aria-label={`${t.pastry.add}: ${p.name}`}
                        >
                          {t.pastry.add}
                          <span class="button-plus" aria-hidden="true">
                            +
                          </span>
                        </button>
                        <div class="mini-stepper" data-mini={p.key} hidden>
                          <button
                            type="button"
                            data-sub={p.key}
                            aria-label={t.pastry.less(p.name)}
                          >
                            −
                          </button>
                          <output
                            data-count={p.key}
                            aria-live="polite"
                          ></output>
                          <button
                            type="button"
                            data-add={p.key}
                            aria-label={t.pastry.more(p.name)}
                          >
                            +
                          </button>
                        </div>
                      </div>
                    ) : null}
                  </li>
                ))}
              </ul>
              {open && !pastryDay && (
                <p class="pastry-later">{t.pastry.saturdayOnly}</p>
              )}
              {!open && (
                <a class="button button-light" href="#avisame">
                  {t.pastry.notify}
                </a>
              )}
              <p
                class="dish-stock"
                data-stock="pastry"
                data-level={stock.pastry.level}
                hidden={open && (!pastryDay || !stockText('pastry'))}
              >
                {open ? stockText('pastry') : t.catalog.closed}
              </p>
              <details class="dish-more">
                <summary>{t.catalog.details}</summary>
                <dl class="spec">
                  <div>
                    <dt>{t.loaf.ingredients}</dt>
                    <dd>{t.pastry.ingredients}</dd>
                  </div>
                  <div>
                    <dt>{t.loaf.allergens}</dt>
                    <dd>{t.pastry.allergens}</dd>
                  </div>
                </dl>
              </details>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Combina Molla: tres combinacions, al preu de les peces, sense descompte -->
    <section
      id="combina"
      class="combos"
      aria-labelledby="combos-title"
      data-event-view="view_product"
    >
      <div class="wrap">
        <div class="mono-bar" data-bar>
          <span>Nº 02 · {t.combos.kicker}</span>
          <span>{t.combos.bar}</span>
        </div>
        <header class="combos-head">
          <h2 id="combos-title" data-split>
            {t.combos.h2a} <em>{t.combos.h2b}</em>
          </h2>
          <p data-reveal>{t.combos.intro}</p>
        </header>
        <ul class="combo-list">
          {combos.map((c) => (
            <li class="combo">
              <figure class="combo-photo">
                <Photo
                  name={c.photo}
                  alt=""
                  sizes="(max-width: 720px) 38vw, 30vw"
                />
              </figure>
              <div class="combo-body">
                <h3>{c.name}</h3>
                <p class="combo-lines">{c.lines}</p>
                <p class="combo-price">
                  <span aria-hidden="true">{tight(c.price)}</span>
                  <span class="visually-hidden">{money(c.price)}</span>
                </p>
                {open && pastryDay && (
                  <button
                    type="button"
                    class="button button-orange combo-add"
                    data-combo={c.id}
                    data-combo-loaf={c.items.loaf}
                    data-combo-croissant={c.items.croissant}
                    data-combo-pain={c.items.pain}
                    data-added={t.combos.added}
                    disabled={!c.fits}
                    aria-label={t.combos.add(c.name)}
                  >
                    {t.catalog.add}
                    <span class="button-plus" aria-hidden="true">
                      +
                    </span>
                  </button>
                )}
              </div>
            </li>
          ))}
        </ul>
        <p class="combos-note">
          {!open
            ? t.catalog.closed
            : !pastryDay
              ? t.pastry.saturdayOnly
              : t.combos.note}
        </p>
      </div>
    </section>

    <!-- Ressenyes de Google: un cartell amb l'índex al costat, com la taula
         del flyer. Una ressenya a la vegada. Cites textuals, en el seu idioma. -->
    <section
      id="resenas"
      class="reviews"
      aria-labelledby="reviews-title"
      data-reviews
    >
      <div class="wrap">
        <div class="mono-bar" data-bar>
          <span>{t.reviews.kicker}</span>
          <span>{t.reviews.fig}</span>
        </div>
        <h2 id="reviews-title" class="reviews-score">
          <span class="reviews-big">{googleReviews.score}</span>{' '}
          <span class="reviews-count">
            {t.reviews.count(googleReviews.count)}
          </span>
        </h2>
        <div class="reviews-board">
          <div class="reviews-stage" data-reviews-stage>
            {googleReviews.quotes.map((r, i) => {
              const [before, after] = r.highlight.split(r.accent);
              return (
                <div
                  class="review-slide"
                  id={`review-${i}`}
                  role="tabpanel"
                  aria-labelledby={`review-tab-${i}`}
                  data-review={i}
                >
                  <figure>
                    <p class="review-top" aria-hidden="true">
                      <span>(Fig. 7.{i + 1})</span>
                      <span>Google · {googleReviews.score}</span>
                    </p>
                    <p class="review-headline" aria-hidden="true">
                      <span class="review-mark">“</span>
                      <span class="review-line">
                        {before}
                        <em>{r.accent}</em>
                        {after}
                      </span>
                    </p>
                    <div class="review-body">
                      <blockquote lang={r.lang}>
                        <p>{r.text}</p>
                      </blockquote>
                      <figcaption class="review-by">
                        <cite>{r.author}</cite>
                        <span>{t.reviews.source}</span>
                      </figcaption>
                    </div>
                  </figure>
                </div>
              );
            })}
          </div>
          <div class="reviews-nav">
            <div
              class="reviews-index"
              role="tablist"
              aria-label={t.reviews.label}
            >
              {googleReviews.quotes.map((r, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`review-tab-${i}`}
                  aria-controls={`review-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-review-tab={i}
                >
                  <span class="review-tab-num">{pad(i + 1)}</span>
                  <span class="review-tab-name">{r.author}</span>
                </button>
              ))}
            </div>
            <div class="reviews-arrows" data-reviews-arrows hidden>
              <button
                type="button"
                class="reviews-arrow"
                data-reviews-prev
                aria-label={t.reviews.prev}
              >
                ←
              </button>
              <button
                type="button"
                class="reviews-arrow"
                data-reviews-next
                aria-label={t.reviews.next}
              >
                →
              </button>
            </div>
          </div>
        </div>
        <div class="reviews-actions">
          <a
            class="button button-light"
            href={googleReviews.profileUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.reviews.all(googleReviews.count)}
            <span aria-hidden="true">↗</span>
            <span class="visually-hidden">{t.reviews.newTab}</span>
          </a>
          <a
            class="button button-ghost reviews-leave"
            href={googleReviews.reviewUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.reviews.leave}
            <span aria-hidden="true">↗</span>
            <span class="visually-hidden">{t.reviews.newTab}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Per què jo i no el forn: tres xifres, sense discurs -->
    <section class="why" aria-labelledby="why-title">
      <div class="wrap">
        <div class="mono-bar" data-bar>
          <span>{t.why.kicker}</span>
          <span>{t.why.bar}</span>
        </div>
        <div class="why-grid">
          <h2 id="why-title" data-split>
            {t.why.h2a} <em>{t.why.h2b}</em>
          </h2>
          <ul class="why-stats" data-reveal>
            {t.why.stats.map(([value, label]) => (
              <li>
                <strong>{value}</strong>
                <span>{label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 2 · Diari de l'obrador: las fotos de la cocina, como un reel -->
    <section class="diary" aria-label={t.film.label} data-diary>
      <div class="diary-pin">
        <div class="wrap mono-bar diary-bar">
          <span>{t.ed.diary}</span>
          <span>
            (Fig. <span data-diary-index>1</span> / {t.film.items.length})
          </span>
        </div>
        <div class="wrap diary-progress" aria-hidden="true">
          {t.film.items.map(() => (
            <span>
              <i />
            </span>
          ))}
        </div>
        <div
          class="diary-track"
          data-film
          tabindex="0"
          role="group"
          aria-label={t.film.label}
        >
          {t.film.items.map(([name, title, text, alt], i) => (
            <figure class:list={['story', { 'story-outline': i % 2 }]}>
              <div class="story-photo">
                <Photo
                  name={name}
                  alt={alt}
                  sizes="(max-width: 720px) 78vw, 34vh"
                />
              </div>
              <span class="story-word" aria-hidden="true">
                {title}
              </span>
              <span class="story-num" aria-hidden="true">
                {i + 1}
              </span>
              <figcaption>
                <strong>{title}</strong>
                <span>{text}</span>
              </figcaption>
              <span class="story-foot" aria-hidden="true">
                <b>molla.</b>
                <span>Baix Llobregat</span>
              </span>
            </figure>
          ))}
        </div>
        <p class="wrap diary-hint" aria-hidden="true">
          {t.ed.swipe} →
        </p>
      </div>
    </section>

    <!-- 7 · Reserva: el tiquet, sobre el azul del flyer -->
    <section id="reserva" class="reserve" aria-labelledby="reserve-title">
      <div class="wrap">
        <div class="mono-bar" data-bar>
          <span>Nº 03 · {t.reserve.kicker}</span>
          <span>{t.ed.reserveBar}</span>
        </div>
      </div>
      <div class="wrap reserve-grid">
        <div class="reserve-intro" data-reveal>
          <h2 id="reserve-title">{t.reserve.h2}</h2>
          <dl class="summary">
            <div>
              <dt>{t.reserve.pickup}</dt>
              <dd>{pickupDay}</dd>
            </div>
            <div>
              <dt>{t.reserve.where}</dt>
              <dd id="recogida" data-event-view="pickup_info_view">
                {t.reserve.pickupLocation}
                <small>{t.reserve.pickupDetails}</small>
                {current.pickupWindow && <small>{current.pickupWindow}</small>}
                <span class="map-links">
                  <a href={routes.delivery[lang]}>{t.reserve.pickupInfo}</a>
                </span>
              </dd>
            </div>
            <div>
              <dt>{t.reserve.pay}</dt>
              <dd>{t.reserve.payValue}</dd>
            </div>
          </dl>
          {brand.whatsapp && (
            <a
              class="text-link"
              data-event="click_whatsapp"
              href={`https://wa.me/${brand.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.reserve.question}
            </a>
          )}
        </div>
        <div class="reservation-panel ticket">
          {open ? (
            <form
              id="reservation-form"
              action={`/api/reservations?lang=${lang}`}
              method="post"
              data-price={loaf.price}
              data-banana-whole={bananaWhole.price}
              data-banana-half={bananaHalf.price}
              data-croissant={croissant.price}
              data-pain={pain.price}
              data-pastry-pool={pastryPool}
            >
              <div class="ticket-head" aria-hidden="true">
                <span>molla.</span>
                <span>Nº {pad(current.number)}</span>
              </div>
              <h3>{t.reserve.yourOrder}</h3>
              {isDemo && <p class="form-intro">{t.reserve.demoIntro}</p>}
              <input type="hidden" name="requestId" value="" />
              <input type="hidden" name="bakeId" value={current.id} />
              <input type="hidden" name="product" value="clasica" />
              <input type="hidden" name="source" value="direct" />
              <div class="order-lines">
                <div class="order-line">
                  <label for="quantity">
                    <span class="line-name">{t.catalog.loaf}</span>
                    <small>
                      {money(loaf.price)} · {t.reserve.qtyMax}
                    </small>
                  </label>
                  <div class="stepper">
                    <button
                      type="button"
                      data-step="-1"
                      data-target="quantity"
                      aria-label={t.reserve.less}
                    >
                      −
                    </button>
                    <input
                      id="quantity"
                      name="quantity"
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max={stock.bread.max}
                      value="0"
                      required
                    />
                    <button
                      type="button"
                      data-step="1"
                      data-target="quantity"
                      aria-label={t.reserve.more}
                    >
                      +
                    </button>
                  </div>
                </div>
                <div class="order-line">
                  <label for="banana-view">
                    <span class="line-name">{t.reserve.bananaQty}</span>
                    <small>
                      {t.catalog.whole} {money(bananaWhole.price)} ·{' '}
                      {t.catalog.half} {money(bananaHalf.price)}
                    </small>
                    <small
                      data-stock="banana"
                      data-level={stock.banana.level}
                      hidden={!stockText('banana')}
                    >
                      {stockText('banana')}
                    </small>
                  </label>
                  <div class="stepper">
                    <button
                      type="button"
                      data-step="-1"
                      data-target="banana"
                      aria-label={t.reserve.bananaLess}
                    >
                      −
                    </button>
                    <output
                      id="banana-view"
                      class="stepper-view"
                      aria-live="polite"
                    >
                      0
                    </output>
                    <input
                      id="banana"
                      name="banana"
                      type="hidden"
                      value="0"
                      data-max={bananaMax}
                    />
                    <button
                      type="button"
                      data-step="1"
                      data-target="banana"
                      aria-label={t.reserve.bananaMore}
                      disabled={bananaMax === 0}
                    >
                      +
                    </button>
                  </div>
                </div>
                {pastryDay && (
                  <>
                    <div class="order-line">
                      <label for="croissant-view">
                        <span class="line-name">{t.catalog.croissant}</span>
                        <small>
                          {money(croissant.price)} · {t.pastry.unit}
                        </small>
                      </label>
                      <div class="stepper">
                        <button
                          type="button"
                          data-step="-1"
                          data-target="croissant"
                          aria-label={t.pastry.less(t.catalog.croissant)}
                        >
                          −
                        </button>
                        <output
                          id="croissant-view"
                          class="stepper-view"
                          aria-live="polite"
                        >
                          0
                        </output>
                        <input
                          id="croissant"
                          name="croissant"
                          type="hidden"
                          value="0"
                          data-max={pastryMax}
                          data-pool="pastry"
                        />
                        <button
                          type="button"
                          data-step="1"
                          data-target="croissant"
                          aria-label={t.pastry.more(t.catalog.croissant)}
                          disabled={pastryMax === 0}
                        >
                          +
                        </button>
                      </div>
                    </div>
                    <div class="order-line">
                      <label for="pain-view">
                        <span class="line-name">{t.catalog.pain}</span>
                        <small>
                          {money(pain.price)} · {t.pastry.unit}
                        </small>
                        <small
                          data-stock="pastry"
                          data-level={stock.pastry.level}
                          hidden={!stockText('pastry')}
                        >
                          {stockText('pastry')}
                        </small>
                      </label>
                      <div class="stepper">
                        <button
                          type="button"
                          data-step="-1"
                          data-target="pain"
                          aria-label={t.pastry.less(t.catalog.pain)}
                        >
                          −
                        </button>
                        <output
                          id="pain-view"
                          class="stepper-view"
                          aria-live="polite"
                        >
                          0
                        </output>
                        <input
                          id="pain"
                          name="pain"
                          type="hidden"
                          value="0"
                          data-max={pastryMax}
                          data-pool="pastry"
                        />
                        <button
                          type="button"
                          data-step="1"
                          data-target="pain"
                          aria-label={t.pastry.more(t.catalog.pain)}
                          disabled={pastryMax === 0}
                        >
                          +
                        </button>
                      </div>
                    </div>
                  </>
                )}
                <div class="order-total">
                  <span>{t.reserve.totalLabel}</span>
                  <output id="total" aria-live="polite">
                    {money(0)}
                  </output>
                </div>
              </div>
              <p class="form-empty" data-empty>
                {t.reserve.emptyOrder}
              </p>
              <div class="perforation" aria-hidden="true"></div>
              <fieldset class="size-choice delivery-choice">
                <legend>{t.reserve.deliveryH}</legend>
                <label>
                  <input type="radio" name="delivery" value="home" checked />
                  <span>
                    <strong>{t.reserve.deliveryHome}</strong>
                    <em>{t.reserve.deliveryHomeHint}</em>
                  </span>
                </label>
                <label>
                  <input type="radio" name="delivery" value="pickup" />
                  <span>
                    <strong>{t.reserve.deliveryPickup}</strong>
                    <em>{t.reserve.deliveryPickupHint}</em>
                  </span>
                </label>
              </fieldset>
              <div class="form-columns address-columns" data-home-fields>
                <div class="field">
                  <label for="town">{t.reserve.town}</label>
                  <select id="town" name="town" required>
                    <option value="">{t.reserve.townPick}</option>
                    {deliveryTowns.map((town) => (
                      <option value={town.id}>{town.name}</option>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label for="address">{t.reserve.address}</label>
                  <input
                    id="address"
                    name="address"
                    autocomplete="street-address"
                    minlength="5"
                    maxlength="160"
                    required
                    placeholder={t.reserve.addressPlaceholder}
                  />
                </div>
              </div>
              <div class="field">
                <label for="name">{t.reserve.name}</label>
                <input
                  id="name"
                  name="name"
                  autocomplete="name"
                  minlength="2"
                  maxlength="100"
                  required
                />
              </div>
              <div class="form-columns">
                <div class="field">
                  <label for="email">{t.reserve.email}</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    maxlength="254"
                    required
                    placeholder="tu@email.com"
                  />
                </div>
                <div class="field">
                  <label for="phone">{t.reserve.phone}</label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    minlength="9"
                    maxlength="22"
                    pattern="[0-9 \(\)\+\-]{9,22}"
                    required
                    placeholder="612 345 678"
                  />
                </div>
              </div>
              <div class="honey" aria-hidden="true">
                <label>
                  {t.reserve.honey}
                  <input name="website" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <label class="check">
                <input type="checkbox" name="pickup" value="yes" required />
                <span>
                  {isDemo
                    ? t.reserve.demoCheck
                    : t.reserve.pickupCheck(pickupDay, current.pickupWindow)}
                </span>
              </label>
              <label class="check">
                <input type="checkbox" name="privacy" value="yes" required />
                <span>
                  {t.reserve.privacyA}{' '}
                  <a href={routes.privacy[lang]} target="_blank">
                    {t.reserve.privacyLink}
                  </a>
                  .
                </span>
              </label>
              <p class="form-error" role="alert" tabindex="-1" hidden></p>
              <button type="submit" class="button full">
                {isDemo ? t.reserve.submitDemo : t.reserve.submit}
              </button>
              <p class="form-footnote">{t.reserve.footnote}</p>
              {whatsappBook && (
                <a
                  class="button button-ghost full"
                  data-event="click_whatsapp"
                  href={whatsappBook}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t.reserve.whatsappCta} <span aria-hidden="true">↗</span>
                </a>
              )}
              <noscript>
                <p>
                  {t.reserve.noscript}{' '}
                  {brand.contact && (
                    <a href={`mailto:${brand.contact}`}>
                      {t.reserve.noscriptMail}
                    </a>
                  )}
                </p>
              </noscript>
            </form>
          ) : (
            <div class="closed-panel">
              <p class="kicker">{statusLabel}</p>
              <h3>{t.reserve.closedH3}</h3>
              <p>{t.reserve.closedP}</p>
              <a class="button" href="#avisame">
                {t.reserve.notify}
              </a>
            </div>
          )}
          <div id="confirmation" hidden tabindex="-1" role="status"></div>
          <Sticker class="ticket-stamp" />
        </div>
      </div>
    </section>

    <!-- Pa fix: després de la primera compra, la subscripció -->
    <section class="fix" aria-labelledby="fix-title">
      <div class="wrap fix-card">
        <div class="mono-bar fix-bar" data-bar>
          <span>{t.fix.kicker}</span>
          <span>{t.fix.bar}</span>
        </div>
        <div class="fix-grid">
          <div>
            <h2 id="fix-title" data-split>
              {t.fix.h2a} <em>{t.fix.h2b}</em>
            </h2>
          </div>
          <div class="fix-side" data-reveal>
            {standingVoucher.active && (
              <p class="fix-voucher">
                <span class="star" aria-hidden="true">
                  ✷
                </span>
                {t.fix.voucher}
              </p>
            )}
            <ul class="fix-facts">
              {t.fix.facts(money(loaf.price)).map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
            <a class="button button-orange" href={routes.standing[lang]}>
              {t.fix.cta}
              <span class="button-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · Preguntas -->
    <section id="preguntas" class="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="mono-bar" data-bar>
          <span>Nº 04 · {t.nav.faq}</span>
          <span>{t.ed.faqBar}</span>
        </div>
        <div class="faq-grid">
          <div class="faq-head">
            <h2 id="faq-title" data-split>
              {t.faq.h2}
            </h2>
          </div>
          <div class="faq-list">
            {t.faq.items.map(([q, a], i) => (
              <details>
                <summary>
                  <span class="faq-num" aria-hidden="true">
                    {pad(i + 1)}
                  </span>
                  <span class="faq-q">{q}</span>
                  <span aria-hidden="true" class="faq-icon"></span>
                </summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Amb la fornada oberta, l'avís és una franja: no competeix amb la reserva -->
    <section
      id="avisame"
      class:list={['waitlist', { 'is-compact': open }]}
      aria-labelledby="waitlist-title"
    >
      <div class="wrap">
        <div class="mono-bar" data-bar>
          <span>Nº 05 · {t.status.UPCOMING}</span>
          <span>{t.ed.waitBar}</span>
        </div>
      </div>
      <div class="wrap waitlist-grid">
        {!open && (
          <figure class="poster" data-wipe>
            <Photo
              name="crumb"
              alt={t.waitlist.poster}
              sizes="(max-width: 960px) calc(100vw - 40px), 44vw"
            />
            <span class="poster-star" aria-hidden="true">
              ✷
            </span>
          </figure>
        )}
        <div class="waitlist-body" data-reveal>
          <h2 id="waitlist-title">{t.waitlist.h2}</h2>
          <p>{t.waitlist.p}</p>
          {brand.whatsappChannel && (
            <p class="waitlist-channel">
              <a
                class="text-link"
                data-event="click_channel"
                href={brand.whatsappChannel}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.waitlist.channel} ↗
              </a>
            </p>
          )}
          <form
            id="waitlist-form"
            action={`/api/waitlist?lang=${lang}`}
            method="post"
          >
            <label for="waitlist-email">{t.waitlist.label}</label>
            <div class="waitlist-input">
              <input
                id="waitlist-email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="254"
                required
                placeholder="tu@email.com"
                disabled={!canSubmit}
              />
              <button class="button" type="submit" disabled={!canSubmit}>
                {t.waitlist.button}
              </button>
            </div>
            <input type="hidden" name="source" value="direct" />
            <div class="honey" aria-hidden="true">
              <input
                name="website"
                aria-label={t.waitlist.honey}
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <label class="check">
              <input
                type="checkbox"
                name="consent"
                value="yes"
                required
                disabled={!canSubmit}
              />
              <span>
                {t.waitlist.consentA}{' '}
                <a href={routes.privacy[lang]}>{t.waitlist.consentLink}</a>.
              </span>
            </label>
            {!canSubmit && <p class="form-footnote">{t.waitlist.disabled}</p>}
            {isDemo && <p class="form-footnote">{t.waitlist.demo}</p>}
            <p class="form-error" role="alert" tabindex="-1" hidden></p>
            <p
              class="waitlist-success"
              role="status"
              data-direct={t.waitlist.successDirect}
              hidden
            >
              {t.waitlist.success}
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- Pedido flotante: aparece al añadir algo; en el móvil, siempre a mano -->
  <div
    class="order-pill"
    role="navigation"
    aria-label={t.mobile.label}
    data-pill
    data-open={open ? 'true' : 'false'}
  >
    <span class="pill-badge" data-pill-count aria-hidden="true">
      0
    </span>
    <span class="pill-text">
      <strong data-pill-title>{t.catalog.pill}</strong>
      <small data-pill-items>
        {t.mobile.loaf} · {money(loaf.price)} · {pickupDay}
      </small>
    </span>
    <span class="pill-total" data-pill-total hidden></span>
    <a class="button button-light" href={orderHref} data-pill-cta>
      {open ? t.catalog.pillCta : t.mobile.notify}
    </a>
  </div>
</Base>
