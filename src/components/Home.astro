---
import Base from '../layouts/Base.astro';
import Photo from './Photo.astro';
import Sticker from './Sticker.astro';
import '../styles/experience.css';
import crumbUrl from '../assets/crumb.json?url';
import {
  brand,
  bake,
  money,
  isDemo,
  launchReady,
  productById,
  PASTRY_MAX_PER_ORDER,
  LOAF_MAX_PER_ORDER,
  standingVoucher,
  googleReviews,
  extraBreadIds,
} from '../lib/config';
import { ui, routes, dayFormat, type Lang } from '../lib/i18n';
import { currentBake, type ActiveBake } from '../lib/store';
import { bakeState, earlyBakesOpen, publicStock } from '../lib/domain';
import { deliveryTowns, isWednesday } from '../lib/delivery';
interface Props {
  lang: Lang;
  // An early bake (Christmas) shown on its own page instead of the weekly one.
  bake?: ActiveBake;
  noindex?: boolean;
}
const { lang, bake: chosen, noindex = false } = Astro.props;
const t = ui[lang];
let current = { ...bake, reserved: 0, bananaReserved: 0, pastryReserved: 0 };
let unavailable = false;
if (chosen) current = chosen;
else if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    unavailable = true;
  }
}
// Christmas: links to the early bakes taking orders, except the one on show.
const madridDate = (iso: string) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(
    new Date(iso),
  );
const xmasPage = { ca: '/nadal', es: '/es/navidad' }[lang];
const xmasLinks =
  isDemo || launchReady
    ? earlyBakesOpen()
        .filter((e) => e.pickupDate !== madridDate(current.pickupDate))
        .map((e) => ({
          href: `${xmasPage}?dia=${e.pickupDate.slice(-2)}`,
          label: dayFormat(lang, `${e.pickupDate}T12:00:00Z`),
        }))
    : [];
const state = unavailable
  ? 'CLOSED'
  : isDemo || launchReady
    ? bakeState(current, current.reserved)
    : 'UPCOMING';
const open = state === 'OPEN';
const statusLabel = t.status[state];
const canSubmit = isDemo || launchReady;
const loaf = productById('clasica')!;
const sourdough = productById('masa-madre')!;
const wholegrain = productById('integral')!;
// The three breads of the menu, sharing the bake's capacity. `field` is the
// order form's input; `loaf` keeps its historic name, `quantity`.
const breads = [
  {
    key: 'loaf',
    field: 'quantity',
    product: loaf,
    name: t.catalog.loaf,
    text: t.breads.items.loaf,
    // Whole first; the cut loaf shows on hover (or a tap on touch screens).
    shots: [
      { name: 'loaves', alt: t.loaf.alt },
      { name: 'slice', alt: t.breads.photos.loaf },
    ],
  },
  {
    key: 'sourdough',
    field: 'sourdough',
    product: sourdough,
    name: t.catalog.sourdough,
    text: t.breads.items.sourdough,
    shots: [
      { name: 'sourdoughLoaf', alt: t.breads.photos.sourdoughLoaf },
      { name: 'sourdough', alt: t.breads.photos.sourdough },
    ],
  },
  {
    key: 'wholegrain',
    field: 'wholegrain',
    product: wholegrain,
    name: t.catalog.wholegrain,
    text: t.breads.items.wholegrain,
    shots: [{ name: 'wholegrain', alt: t.breads.photos.wholegrain }],
  },
];
// Breads with a filling and the milk loaf: same cards, same oven. Their key
// is the product id, which is also the order form's field.
const extras = extraBreadIds.map((id) => {
  const e = t.breads.extra[id];
  return {
    key: id,
    field: id,
    product: productById(id)!,
    name: e.name,
    text: e.text,
    shots: [{ name: id, alt: e.alt }],
  };
});
// The counter: the nine breads in one row, each on its round board. The
// shots from above turn with the scroll; the side views stay still.
const plates: Record<string, string> = {
  loaf: 'slice',
  sourdough: 'sourdough',
  wholegrain: 'wholegrain',
};
const menuBreads = [...breads, ...extras].map((b) => ({
  ...b,
  plate: plates[b.key] ?? b.key,
  plateAlt: b.shots[b.shots.length - 1]!.alt,
  spin: !['sourdough', 'wholegrain'].includes(b.key),
}));
// The breads, the banana bread and the two pastries.
const menuCount = menuBreads.length + 3;
const bananaWhole = productById('banana')!;
const bananaHalf = productById('banana-mitad')!;
// Levels, not counts: the page never says how many are left.
const stock = publicStock(current);
const breadMax = Math.min(LOAF_MAX_PER_ORDER, stock.bread.max);
const stockText = (k: 'bread' | 'banana' | 'pastry') =>
  t.catalog.stock[k][stock[k].level];
const bananaMax = stock.banana.max;
const croissant = productById('croissant')!;
const pain = productById('pain-au-chocolat')!;
// Croissants and pains au chocolat go out with every bake, sharing one pool.
const pastryPool = stock.pastry.max;
const pastryMax = Math.min(PASTRY_MAX_PER_ORDER, pastryPool);
const pastries = [
  {
    key: 'croissant',
    product: croissant,
    name: t.catalog.croissant,
    text: t.pastry.croissantText,
  },
  {
    key: 'pain',
    product: pain,
    name: t.catalog.pain,
    text: t.pastry.painText,
  },
] as const;
// Without the database the configured bake is only a placeholder: never show its date.
// Wednesday bakes also deliver in the evening: the form offers the choice.
const wed = !unavailable && isWednesday(current.pickupDate);
// The hero button puts a loaf in the order and opens the form at delivery.
const quickLoaf = open && stock.bread.max > 0;
const pickupDay = unavailable
  ? t.bake.dateSoon
  : dayFormat(lang, current.pickupDate);
const orderHref = open ? '#reservation-form' : '#avisame';
// «sábado» or «miércoles»: the button names the day the bread arrives.
const pickupWeekday = unavailable
  ? ''
  : new Intl.DateTimeFormat(lang === 'ca' ? 'ca-ES' : 'es-ES', {
      timeZone: 'Europe/Madrid',
      weekday: 'long',
    }).format(new Date(current.pickupDate));
// Prices in the flyer's shorthand: "5€", "8€".
const short = (cents: number) =>
  cents % 100 ? money(cents) : `${cents / 100}€`;
// "2,20€": the flyer's shorthand also for prices with cents.
const tight = (cents: number) =>
  `${(cents / 100).toFixed(2).replace('.', ',')}€`;
const pad = (n: number | string) => String(n).padStart(2, '0');
// Booking by WhatsApp with the message half written: for neighbours who
// prefer a chat to a form.
const whatsappBook = brand.whatsapp
  ? `https://wa.me/${brand.whatsapp}?text=${encodeURIComponent(t.reserve.whatsappText(pickupDay))}`
  : '';
// "Tell me about the next bake" as a chat message: easier than an email.
const whatsappNotify = brand.whatsapp
  ? `https://wa.me/${brand.whatsapp}?text=${encodeURIComponent(t.waitlist.whatsappText)}`
  : '';
const abs = (path: string) =>
  brand.site ? new URL(path, brand.site).href : undefined;
const offer = (price: number, available: boolean) => ({
  '@type': 'Offer',
  url: abs(`${routes.home[lang]}#carta`),
  price: (price / 100).toFixed(2),
  priceCurrency: 'EUR',
  availability: available
    ? 'https://schema.org/InStock'
    : 'https://schema.org/OutOfStock',
  availableDeliveryMethod: [
    'http://purl.org/goodrelations/v1#DeliveryModeOwnFleet',
    'http://purl.org/goodrelations/v1#DeliveryModePickUp',
  ],
  areaServed: [
    ...deliveryTowns.map((town) => ({ '@type': 'City', name: town.name })),
    { '@type': 'AdministrativeArea', name: 'Baix Llobregat' },
  ],
  seller: { '@id': abs('/#organization') },
});
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: t.loaf.name,
    description: `${t.loaf.fermentationValue}. ${t.loaf.ingredientsValue}`,
    image: [abs('/images/loaves-1100.webp'), abs('/images/crumb-1100.webp')],
    brand: { '@type': 'Brand', name: brand.name },
    weight: {
      '@type': 'QuantitativeValue',
      minValue: 750,
      maxValue: 850,
      unitCode: 'GRM',
    },
    offers: offer(loaf.price, open),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${t.banana.h2a} ${t.banana.h2b.replace(/\.$/, '')}`,
    description: `${t.banana.p} ${t.loaf.ingredients}: ${t.banana.ingredientsValue}`,
    image: [abs('/images/banana-1100.webp')],
    // Spelled out so search engines quote these ingredients, not other bakeries'.
    additionalProperty: [
      {
        '@type': 'PropertyValue',
        name: t.loaf.ingredients,
        value: t.banana.ingredientsValue,
      },
      {
        '@type': 'PropertyValue',
        name: t.loaf.allergens,
        value: t.banana.allergensValue,
      },
    ],
    brand: { '@type': 'Brand', name: brand.name },
    offers: [
      {
        ...offer(bananaWhole.price, open && bananaMax >= 2),
        name: t.catalog.bananaWhole,
      },
      {
        ...offer(bananaHalf.price, open && bananaMax >= 1),
        name: t.catalog.bananaHalf,
      },
    ],
  },
  ...[sourdough, wholegrain].map((b, i) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: [t.catalog.sourdough, t.catalog.wholegrain][i],
    description: [t.breads.items.sourdough, t.breads.items.wholegrain][i],
    image: [abs('/images/loaves-1100.webp')],
    brand: { '@type': 'Brand', name: brand.name },
    offers: offer(b.price, open && stock.bread.max > 0),
  })),
  ...extras.map((b) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: b.name,
    description: `${b.text} ${t.loaf.ingredients}: ${t.breads.extra[b.key].ingredients}`,
    image: [abs(`/images/${b.key}-1100.webp`)],
    brand: { '@type': 'Brand', name: brand.name },
    offers: offer(b.product.price, open && stock.bread.max > 0),
  })),
  ...pastries.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description: `${p.text} ${t.pastry.ingredients}`,
    image: [abs('/images/pastries-1100.webp')],
    brand: { '@type': 'Brand', name: brand.name },
    offers: offer(p.product.price, open && pastryPool > 0),
  })),
];
---

<Base
  lang={lang}
  route={chosen ? undefined : 'home'}
  jsonLd={chosen ? [] : jsonLd}
  noindex={noindex}
  minimal
>
  <main id="contenido" class="xp">
    <!-- 1 · La molla viva: la miga del packaging respira i s'obre on la toques -->
    <section class="alive" aria-labelledby="hero-title" data-alive>
      <canvas
        class="alive-canvas"
        data-crumb={crumbUrl}
        aria-hidden="true"
      ></canvas>
      <div class="alive-center">
        <div class="alive-tag">
          <span class="alive-mark" aria-hidden="true">
            molla<i>.</i>
          </span>
          <h1 id="hero-title" class="alive-title">
            {t.hero.h1a} {t.hero.h1b}.
          </h1>
        </div>
      </div>
      <div
        id="hornada"
        class="wrap alive-bake"
        data-state={state}
        data-event-view="view_current_bake"
        aria-labelledby="bake-title"
        role="region"
      >
        <p class="status">
          <span class="status-dot" aria-hidden="true"></span>
          <span data-bake-label>{statusLabel}</span>
        </p>
        <h2 id="bake-title" class="stub-day">
          {pickupDay}
        </h2>
        {open && (
          <p
            class="stub-countdown"
            data-countdown={current.deadline}
            data-countdown-label={t.bake.closesIn}
            hidden
          ></p>
        )}
        {!open && (
          <p class="stub-deadline">
            {unavailable
              ? t.bake.unavailable
              : state === 'UPCOMING'
                ? t.bake.upcoming
                : t.bake.closed}
          </p>
        )}
        <p
          class="stub-count"
          data-stock="bread"
          data-level={stock.bread.level}
          hidden={!open || stock.bread.level !== 'low'}
        >
          {t.catalog.stock.bread.low}
        </p>
        <a class="stub-trust" href="#ressenya">
          <span aria-hidden="true">★★★★★</span>
          {t.hero.trust(googleReviews.score, googleReviews.count)}
        </a>
        <a
          class="button button-orange stub-cta"
          href={orderHref}
          data-bake-cta
          data-quick-loaf={quickLoaf ? '' : undefined}
        >
          {quickLoaf
            ? t.bake.ctaQuick(money(loaf.price))
            : open && pickupWeekday
              ? t.bake.ctaOpen(pickupWeekday)
              : t.bake.ctaClosed}
          <span class="button-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
      <p class="wrap alive-hint" aria-hidden="true">
        <span>
          <i></i>
          {t.xp.hint}
        </span>
      </p>
    </section>

    <!-- 2 · 35 hores en una pantalla: la massa puja i s'omple d'alvèols -->
    <section
      id="fermentacio"
      class="ferment"
      aria-labelledby="ferment-title"
      data-ferment
    >
      <div class="wrap">
        <div class="xp-bar">
          <span>{t.xp.ferment.kicker}</span>
          <span>{t.xp.ferment.bar}</span>
        </div>
        <div class="ferment-grid">
          <div class="ferment-clock">
            <h2 id="ferment-title" class="ferment-lead">
              {t.xp.ferment.lead}
              <span class="ferment-hours" aria-hidden="true">
                <span data-ferment-hours>35</span>
                <small>h</small>
              </span>
              <span class="visually-hidden">35 h</span>
            </h2>
            <p class="ferment-phase" aria-live="polite">
              <b data-ferment-word>{t.xp.ferment.phases.at(-1)![1]}</b>
              <span data-ferment-say>{t.xp.ferment.phases.at(-1)![2]}</span>
            </p>
            <div class="ferment-scrub">
              <input
                type="range"
                min="0"
                max="35"
                step="0.1"
                value="35"
                aria-label={t.xp.ferment.slider}
                data-ferment-scrub
              />
              <div class="ferment-scale" aria-hidden="true">
                <span>0 h</span>
                <span class="ferment-drag">{t.xp.ferment.drag}</span>
                <span>35 h</span>
              </div>
            </div>
            <div
              class="ferment-vs"
              role="img"
              aria-label={t.xp.ferment.compare}
            >
              <div class="vs-row">
                <span>{t.xp.ferment.fast}</span>
                <i style="--w: 8.57%" data-vs-fast></i>
                <b>{t.xp.ferment.fastValue}</b>
              </div>
              <div class="vs-row vs-me">
                <span>{t.xp.ferment.me}</span>
                <i style="--w: 100%" data-vs-me></i>
                <b data-vs-me-h>35 h</b>
              </div>
            </div>
          </div>
          <figure class="ferment-tin">
            <canvas aria-hidden="true" data-ferment-canvas></canvas>
            <button type="button" class="ferment-replay" data-ferment-replay>
              {t.xp.ferment.replay}
            </button>
            <figcaption class="xp-cap">
              <span>{t.xp.ferment.fig}</span>
              <span data-ferment-fig>35 h</span>
            </figcaption>
          </figure>
        </div>
        <script
          type="application/json"
          data-ferment-phases
          set:html={JSON.stringify(t.xp.ferment.phases)}
        ></script>
      </div>
    </section>

    <!-- 3 · El tall: el ganivet parteix la paraula i s'obre el pa -->
    <section class="cut" aria-label={t.xp.cut.label} data-cut>
      <div class="cut-stick">
        <figure class="cut-photo">
          <div class="cut-blur" aria-hidden="true">
            <Photo name="crumb2" alt="" sizes="50vw" />
          </div>
          <Photo
            name="crumb2"
            alt={t.hero.photos[1]!}
            class="cut-loaf"
            sizes="(max-width: 820px) 100vw, 75vh"
          />
        </figure>
        <p class="cut-says">{t.xp.cut.says}</p>
        <div class="wrap cut-cap">
          <span>{t.xp.cut.fig}</span>
          <span>{t.ed.ferment}</span>
        </div>
        <div class="cut-lid cut-top" aria-hidden="true">
          <div class="wrap xp-bar cut-bar">
            <span>{t.xp.cut.label}</span>
            <span>{t.xp.cut.scroll} ↓</span>
          </div>
          <span class="cut-word">
            {t.xp.cut.word[0]}
            <em>{t.xp.cut.word[1]}</em>
          </span>
        </div>
        <div class="cut-lid cut-bot" aria-hidden="true">
          <span class="cut-word">
            {t.xp.cut.word[0]}
            <em>{t.xp.cut.word[1]}</em>
          </span>
        </div>
        <div class="cut-knife" aria-hidden="true"></div>
      </div>
    </section>

    <!-- 4 · El taulell: tota la carta, un producte cada vegada -->
    <section
      id="carta"
      class="counter"
      aria-labelledby="catalog-title"
      data-counter
      data-event-view="view_product"
    >
      <div class="counter-stick">
        <div class="wrap xp-bar">
          <span id="catalog-title">Nº 02 · {t.xp.counter.bar}</span>
          <span class="counter-hint" aria-hidden="true">
            {t.xp.counter.hint}
          </span>
        </div>
        <div class="counter-rail">
          <button
            type="button"
            class="counter-arrow counter-prev"
            data-counter-prev
            aria-label={t.xp.counter.prev}
          >
            ←
          </button>
          <button
            type="button"
            class="counter-arrow counter-next"
            data-counter-next
            aria-label={t.xp.counter.next}
          >
            →
          </button>
          <ul class="bread-list" data-counter-track>
            {menuBreads.map((b, i) => (
              <li class="bread-card" data-bread={b.key}>
                <div class="bread-plate">
                  <Photo
                    name={b.plate}
                    alt={b.plateAlt}
                    class={b.spin ? 'is-spin' : ''}
                    sizes="(max-width: 820px) 72vw, 40vw"
                  />
                </div>
                <div class="bread-info">
                  <span class="bread-idx" aria-hidden="true">
                    {pad(i + 1)} / {pad(menuCount)}
                  </span>
                  <h3>{b.name}</h3>
                  <p class="bread-price">
                    <span aria-hidden="true">{tight(b.product.price)}</span>
                    <span class="visually-hidden">
                      {money(b.product.price)} · {t.breads.unit}
                    </span>
                  </p>
                  <p class="bread-text">{b.text}</p>
                  {open && (
                    <div class="dish-buy" data-buy={b.key}>
                      <button
                        type="button"
                        class="add"
                        data-add={b.key}
                        disabled={breadMax === 0}
                        aria-label={t.breads.more(b.name)}
                      >
                        {t.breads.add}
                        <b aria-hidden="true">+</b>
                      </button>
                      <div class="mini-stepper" data-mini={b.key} hidden>
                        <button
                          type="button"
                          data-sub={b.key}
                          aria-label={t.breads.less(b.name)}
                        >
                          −
                        </button>
                        <output data-count={b.key} aria-live="polite"></output>
                        <button
                          type="button"
                          data-add={b.key}
                          aria-label={t.breads.more(b.name)}
                        >
                          +
                        </button>
                      </div>
                    </div>
                  )}
                </div>
              </li>
            ))}
            <li class="bread-card" data-bread="banana">
              <div class="bread-plate">
                <Photo
                  name="banana"
                  alt={t.banana.alt}
                  sizes="(max-width: 820px) 72vw, 40vw"
                />
              </div>
              <div class="bread-info">
                <span class="bread-idx" aria-hidden="true">
                  {pad(menuBreads.length + 1)} / {pad(menuCount)}
                </span>
                <h3 id="banana-title">
                  {t.banana.h2a} <em>{t.banana.h2b}</em>
                </h3>
                <fieldset class="sizes" disabled={!open}>
                  <legend class="visually-hidden">{t.catalog.size}</legend>
                  <label>
                    <input type="radio" name="banana-size" value="2" checked />
                    <span>
                      {t.ed.whole} <b>{short(bananaWhole.price)}</b>
                    </span>
                  </label>
                  <label>
                    <input type="radio" name="banana-size" value="1" />
                    <span>
                      {t.ed.half} <b>{short(bananaHalf.price)}</b>
                    </span>
                  </label>
                </fieldset>
                <p class="bread-text">{t.banana.short}</p>
                <p
                  class="dish-stock"
                  data-stock="banana"
                  data-level={stock.banana.level}
                  hidden={open && !stockText('banana')}
                >
                  {open ? stockText('banana') : t.catalog.closed}
                </p>
                {open && (
                  <div class="dish-buy" data-buy="banana">
                    <button
                      type="button"
                      class="add"
                      data-add="banana"
                      disabled={bananaMax === 0}
                    >
                      {t.catalog.add}
                      <b aria-hidden="true">+</b>
                    </button>
                    <div class="mini-stepper" data-mini="banana" hidden>
                      <button
                        type="button"
                        data-sub="banana"
                        aria-label={t.reserve.bananaLess}
                      >
                        −
                      </button>
                      <output data-count="banana" aria-live="polite"></output>
                      <button
                        type="button"
                        data-add="banana"
                        data-halves="1"
                        aria-label={t.reserve.bananaMore}
                      >
                        +
                      </button>
                    </div>
                  </div>
                )}
              </div>
            </li>
            {pastries.map((p, i) => (
              <li class="bread-card" data-bread={p.key}>
                <div class="bread-plate">
                  <Photo
                    name={p.key === 'croissant' ? 'croissant' : 'pastries'}
                    alt={t.pastry.alt}
                    sizes="(max-width: 820px) 72vw, 40vw"
                  />
                </div>
                <div class="bread-info">
                  <span class="bread-idx" aria-hidden="true">
                    {pad(menuBreads.length + 2 + i)} / {pad(menuCount)}
                  </span>
                  <h3>{p.name}</h3>
                  <p class="bread-price">
                    <span aria-hidden="true">{tight(p.product.price)}</span>
                    <span class="visually-hidden">
                      {money(p.product.price)} · {t.pastry.unit}
                    </span>
                  </p>
                  <p class="bread-text">{p.text}</p>
                  {i === 1 && (
                    <p
                      class="dish-stock"
                      data-stock="pastry"
                      data-level={stock.pastry.level}
                      hidden={open && !stockText('pastry')}
                    >
                      {open ? stockText('pastry') : t.catalog.closed}
                    </p>
                  )}
                  {open && (
                    <div class="dish-buy" data-buy={p.key}>
                      <button
                        type="button"
                        class="add"
