---
import Article from '../../layouts/Article.astro';
import Photo from '../../components/Photo.astro';
import { brand, isDemo, launchReady } from '../../lib/config';
import { dayFormat, madridParts } from '../../lib/i18n';
import { currentBake } from '../../lib/store';
let current: Awaited<ReturnType<typeof currentBake>> | undefined;
if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    /* Shows the weekly rhythm without a date. */
  }
}
const close = current && madridParts('es', current.deadline);
const place = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: `Punto de recogida ${brand.name}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sant Boi de Llobregat',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
};
---

<Article
  lang="es"
  route="pickup"
  crumb="Recogida"
  title={`Recogida de pan artesanal en Sant Boi de Llobregat · ${brand.name}`}
  description="Dónde y cuándo recoger tu hogaza de fermentación lenta en Sant Boi de Llobregat. Reserva online, recógela el sábado y paga al recoger. El punto exacto se confirma con el pedido."
  kicker="Recogida · Sant Boi de Llobregat"
  h1="Recoge tu pan en Sant Boi de Llobregat."
  lede="Una vez por semana, el sábado, en Sant Boi de Llobregat. Reservas antes, pagas al recoger y te llevas el pan del día."
  jsonLd={[place]}
>
  <div class="article-grid">
    <div class="prose">
      <h2>Dónde</h2>
      <p>
        <strong>Punto de recogida en Sant Boi de Llobregat.</strong> Te
        confirmaremos el punto exacto de recogida con tu pedido.
      </p>

      <h2>Cuándo</h2>
      <p>
        {current ? (
          <>
            Los sábados. La próxima recogida es el{' '}
            <strong>{dayFormat('es', current.pickupDate)}</strong>
            {current.pickupWindow
              ? `, ${current.pickupWindow}`
              : '. El horario de recogida se confirma con el pedido'}
            . Los pedidos se cierran el {close!.weekday} {close!.day} a las{' '}
            {close!.time} o cuando se completa la hornada.
          </>
        ) : (
          <>
            Sábado · horario de recogida confirmado con el pedido. Los pedidos
            se cierran dos días antes a las 20:00 o cuando se completa la
            hornada.
          </>
        )}
      </p>

      <h2>Cómo funciona</h2>
      <ol>
        <li>
          Reservas en la web y recibes por email una confirmación con tu código
          de recogida. El día antes te llega un recordatorio.
        </li>
        <li>
          El sábado vienes al punto de recogida dentro de la franja horaria.
        </li>
        <li>
          Dices tu código, pagas y te llevas tu hogaza, horneada ese mismo día.
        </li>
      </ol>
      <p>
        Si al final no puedes venir, responde al email de confirmación cuanto
        antes con tu código: así libero tu pan para otra persona.
      </p>

      <h2>Si vienes de fuera de Sant Boi</h2>
      <p>
        Hago pan para todo el Baix Llobregat. La recogida es en Sant Boi de
        Llobregat, también si vives en Santa Coloma de Cervelló, Sant Vicenç
        dels Horts, Cornellà de Llobregat, Sant Joan Despí, Viladecans o Sant
        Climent de Llobregat. De momento no hago envíos a domicilio.
      </p>
    </div>
    <figure class="article-photo">
      <Photo
        name="hands"
        alt="Mano sujetando una hogaza de corteza oscura mientras se corta con un cuchillo de pan"
        sizes="(max-width: 860px) calc(100vw - 40px), 40vw"
      />
    </figure>
  </div>
</Article>
