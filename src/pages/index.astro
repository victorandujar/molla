---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import {
  brand,
  bake,
  products,
  money,
  pickupDay,
  isDemo,
  launchReady,
} from '../lib/config';
import { currentBake } from '../lib/store';
import { bakeState } from '../lib/domain';
import { randomUUID } from 'node:crypto';
let current = { ...bake, reserved: 0 };
let unavailable = false;
if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    unavailable = true;
  }
}
const state = unavailable
  ? 'CLOSED'
  : isDemo || launchReady
    ? bakeState(current, current.reserved)
    : 'UPCOMING';
const open = state === 'OPEN';
const statusLabel = {
  OPEN: 'Reservas abiertas',
  SOLD_OUT: 'Hornada agotada',
  CLOSED: 'Pedidos cerrados',
  UPCOMING: 'Estamos preparando la primera hornada',
  COMPLETED: 'Esta hornada ya salió del horno',
}[state];
const canSubmit = isDemo || launchReady;
const productStructured = launchReady
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: products[0].subtitle,
      description: products[0].ingredients,
      image: new URL('/images/crumb-1100.webp', brand.site).href,
      brand: { '@type': 'Brand', name: brand.name },
      offers: {
        '@type': 'Offer',
        url: new URL('/#reserva', brand.site).href,
        price: (products[0].price / 100).toFixed(2),
        priceCurrency: 'EUR',
        availability: open
          ? 'https://schema.org/InStock'
          : 'https://schema.org/OutOfStock',
        seller: { '@type': 'Organization', name: brand.name },
      },
    }).replace(/</g, '\\u003c')
  : null;
---

<Base>
  {productStructured && (
    <script
      is:inline
      type="application/ld+json"
      set:html={productStructured}
    ></script>
  )}
  <main id="contenido">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="small-rule"></span> MASA MADRE · HORNEADO AQUÍ
        </p>
        <h1 id="hero-title">
          Tu pan.
          <br />
          Aquí al lado.
          <br />
          <span>El sábado.</span>
        </h1>
        <p class="hero-description">
          Hago pocas hogazas de masa madre cada semana, en Santa Coloma de
          Cervelló.
          <br /> Tú reservas. Yo pongo el horno.
        </p>
        <a class="button" href="#hornada">
          {open ? 'Quiero mi pan' : 'Ver la próxima hornada'}{' '}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="hero-note">
          Desde {money(products[0].price)} · Recogida local · Sin envíos
        </p>
      </div>
      <figure class="hero-photo">
        <Photo
          name="hero"
          alt="Dos hogazas de masa madre, una cortada mostrando la miga, junto a los azulejos azules de mi cocina"
          eager
        />
        <figcaption>
          <span>PAN, LUZ Y MI COCINA.</span>
          <span>01 / SANTA COLOMA</span>
        </figcaption>
        <div class="photo-stamp" aria-hidden="true">
          Harina.
          <br />
          Agua. Sal.
          <br />
          <em>Y tiempo.</em>
        </div>
      </figure>
    </section>
    <div class="manifesto">
      <div class="wrap">
        <span>Una persona</span>
        <span aria-hidden="true">✳</span>
        <span>Una hornada a la semana</span>
        <span aria-hidden="true">✳</span>
        <span>Pan por encargo</span>
      </div>
    </div>
    <section
      id="hornada"
      class="bake-section wrap"
      aria-labelledby="bake-title"
      data-event-view="view_current_bake"
    >
      <div class="section-intro">
        <p class="eyebrow">LA CITA DE LA SEMANA</p>
        <h2 id="bake-title">
          El próximo pan
          <br />
          tiene fecha.
        </h2>
        <p>
          Reservo tiempo para hacerlo.
          <br />
          Tú, un hueco en la mesa.
        </p>
      </div>
      <div class="bake-board" data-state={state}>
        <div class="bake-top">
          <span>HORNADA #{bake.number}</span>
          <span class="status">
            <span class="status-dot"></span>
            <span data-bake-label>{statusLabel}</span>
          </span>
        </div>
        <h3>{pickupDay}</h3>
        <p>Recogida en {brand.town}</p>
        <div class="capacity">
          <div>
            <strong data-reserved>{current.reserved}</strong>
            <span> / {current.capacity} hogazas reservadas</span>
          </div>
          <span class="capacity-note">
            Cupo de esta hornada{isDemo ? ' de prueba' : ''}
          </span>
        </div>
        <progress
          value={current.reserved}
          max={current.capacity}
          aria-label={`${current.reserved} de ${current.capacity} hogazas reservadas`}
        ></progress>
        <p class="deadline">
          {open
            ? 'Pedidos hasta el jueves a las 20:00, o hasta completar la hornada.'
            : state === 'UPCOMING'
              ? 'Te contaré la fecha definitiva al abrir reservas.'
              : 'Esta semana ya no acepto más pedidos. Puedes pedir un aviso para la próxima.'}
        </p>
        {unavailable && (
          <p role="status">
            No puedo consultar el cupo ahora. Recarga la página antes de
            reservar.
          </p>
        )}
        <a
          class="text-link"
          href={open ? '#reserva' : '#avisame'}
          data-bake-cta
        >
          {open ? 'Reservar mi hogaza' : 'Avísame de la próxima'}{' '}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="bread-section wrap" aria-labelledby="bread-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">POCO PAN. BIEN HECHO.</p>
          <h2 id="bread-title">Lo que sale del horno.</h2>
        </div>
        <p>
          Una hogaza para volver.
          <br />
          Y, más adelante, algo distinto.
        </p>
      </div>
      <div class="product-grid">
        {products.map((product, i) => (
          <article
            class:list={['product', { 'product-soon': !product.available }]}
            data-event-view="view_product"
          >
            <a
              href={product.available ? '#reserva' : '#avisame'}
              aria-label={
                product.available
                  ? 'La clásica: reservar hogaza'
                  : 'Más adelante: recibir novedades de la especial'
              }
            >
              <div class="product-image">
                <Photo
                  name={product.image}
                  alt={
                    i === 0
                      ? 'Interior de una hogaza de masa madre con corteza tostada'
                      : 'Dos hogazas de corteza tostada sobre una tabla de madera'
                  }
                />
                <span class="image-label">
                  {product.available ? 'LA CLÁSICA' : 'MÁS ADELANTE'}
                </span>
              </div>
            </a>
            <div class="product-title">
              <h3>{product.name}</h3>
              <span>
                {product.available ? money(product.price) : 'Próximamente'}
              </span>
            </div>
            <p>
              {product.subtitle} · {product.weight}
            </p>
            <p class="ingredients">{product.ingredients}</p>
            {product.allergens && (
              <p class="allergens">
                {product.allergens} Consulta antes de reservar si tienes otras
                alergias.
              </p>
            )}
            {!product.available && (
              <p class="allergens">
                La foto muestra una hogaza real de las pruebas, no una receta
                especial disponible.
              </p>
            )}
            <a
              class="text-link"
              href={product.available ? '#reserva' : '#avisame'}
            >
              {product.available ? 'Esta es la mía' : 'Quiero enterarme'}{' '}
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section id="como" class="how-section">
      <div class="wrap how-layout">
        <div>
          <p class="eyebrow">DE MI HORNO A TU MESA</p>
          <h2>Así de sencillo.</h2>
          <p>
            Sin cuenta. Sin envíos.
            <br />
            Nos vemos el sábado.
          </p>
        </div>
        <ol>
          <li>
            <span>01</span>
            <div>
              <h3>Encargas durante la semana.</h3>
              <p>
                Eliges cuántas hogazas quieres. Cierro pedidos el jueves a las
                20:00 o cuando se llena la hornada.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Yo preparo tu pan.</h3>
              <p>
                Harina, agua, sal y masa madre. Fermentación lenta y una
                producción que puedo cuidar.
              </p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Lo recoges el sábado.</h3>
              <p>
                Tu reserva incluye lugar y franja de recogida. Pagas al recoger.
                Y el pan se va contigo.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>
    <section class="maker-section wrap">
      <div class="maker-image">
        <Photo
          name="maker"
          alt="El panadero cortando una hogaza en su cocina doméstica de Santa Coloma de Cervelló"
        />
        <span class="image-caption">EL OBRADOR, POR AHORA, ES MI COCINA.</span>
      </div>
      <div class="maker-copy">
        <p class="eyebrow">DETRÁS DEL PAN ESTOY YO</p>
        <h2>
          Empiezo pequeño.
          <br />Y empiezo aquí.
        </h2>
        <p>
          No hay un gran equipo detrás. Soy yo, mi masa madre y el horno de
          casa.
        </p>
        <p>
          Estoy empezando a hacer pan por encargo para gente de cerca. Pocas
          hogazas cada semana, para poder dedicar a cada una el tiempo que
          necesita.
        </p>
        <p>
          Las fotos son de mi pan y de mi cocina. Si te apetece probarlo, nos
          vemos el sábado.
        </p>
        <a class="text-link" href="#hornada">
          Ver esta hornada <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="process-strip wrap" aria-label="El proceso en fotografías">
      <figure>
        <Photo
          name="dough"
          alt="Dos masas reposando en bannetons redondos y alargados"
        />
        <figcaption>01 — Dejar que la masa haga lo suyo.</figcaption>
      </figure>
      <figure>
        <Photo
          name="hands"
          alt="Mis manos cortando una hogaza sobre la encimera con luz natural"
        />
        <figcaption>02 — Y luego, partir el pan.</figcaption>
      </figure>
    </section>
    <section id="reserva" class="reserve-section">
      <div class="wrap reserve-layout">
        <div>
          <p class="eyebrow">TU HOGAZA DEL SÁBADO</p>
          <h2>
            Te guardo
            <br />
            una.
          </h2>
          <p>
            Hogaza clásica · {money(products[0].price)}
            <br />
            {pickupDay}
          </p>
          <div
            id="recogida"
            class="pickup-detail"
            data-event-view="pickup_info_view"
          >
            <h3>¿Dónde nos vemos?</h3>
            <p>
              {brand.pickupAddress || 'Santa Coloma de Cervelló'}
              <br />
              {brand.pickupWindow ||
                'El punto y la franja de recogida se publicarán antes de abrir pedidos.'}
            </p>
            <p>Solo recogida local. Pago al recoger.</p>
            {brand.whatsapp && (
              <a
                data-event="click_whatsapp"
                href={`https://wa.me/${brand.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Tengo una pregunta ↗
              </a>
            )}
          </div>
        </div>
        <div class="reservation-panel">
          {open ? (
            <form
              id="reservation-form"
              action="/api/reservations"
              method="post"
              data-price={products[0].price}
            >
              <h3>Reserva en un momento.</h3>
              <p class="form-intro">
                {isDemo
                  ? 'Prueba el recorrido con datos ficticios. No se enviarán emails ni se encargará pan.'
                  : 'Sin adelantos. Pagas al recoger tu pan.'}
              </p>
              <input type="hidden" name="requestId" value={randomUUID()} />
              <input type="hidden" name="bakeId" value={bake.id} />
              <input type="hidden" name="product" value="clasica" />
              <input type="hidden" name="source" value="direct" />
              <div class="quantity-line">
                <label for="quantity">Hogazas</label>
                <div class="stepper">
                  <button
                    type="button"
                    data-step="-1"
                    aria-label="Quitar una hogaza"
                  >
                    −
                  </button>
                  <input
                    id="quantity"
                    name="quantity"
                    type="number"
                    min="1"
                    max={Math.min(4, current.capacity - current.reserved)}
                    value="1"
                    required
                  />
                  <button
                    type="button"
                    data-step="1"
                    aria-label="Añadir una hogaza"
                  >
                    +
                  </button>
                </div>
                <output id="total" aria-live="polite">
                  {money(products[0].price)}
                </output>
              </div>
              <label for="name">Tu nombre</label>
              <input
                id="name"
                name="name"
                autocomplete="name"
                minlength="2"
                maxlength="100"
                required
                placeholder="¿Cómo te llamas?"
              />
              <div class="form-columns">
                <div>
                  <label for="email">Email</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    maxlength="254"
                    required
                    placeholder="tu@email.com"
                  />
                </div>
                <div>
                  <label for="phone">Móvil / WhatsApp</label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    minlength="9"
                    maxlength="22"
                    pattern="[+0-9 ()\-]{9,22}"
                    required
                    placeholder="612 345 678"
                  />
                </div>
              </div>
              <div class="honey" aria-hidden="true">
                <label>
                  Deja este campo vacío
                  <input name="website" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <label class="check">
                <input type="checkbox" name="pickup" value="yes" required />
                <span>
                  {isDemo
                    ? 'Entiendo que estoy probando una reserva ficticia.'
                    : `Recogeré el pan el ${pickupDay}, en ${brand.pickupAddress}, ${brand.pickupWindow}.`}
                </span>
              </label>
              <label class="check">
                <input type="checkbox" name="privacy" value="yes" required />
                <span>
                  He leído la{' '}
                  <a href="/privacidad" target="_blank">
                    privacidad y las condiciones
                  </a>{' '}
                  para gestionar mi reserva.
                </span>
              </label>
              <p class="form-error" role="alert" tabindex="-1" hidden></p>
              <button type="submit" class="button full">
                {isDemo ? 'Probar reserva' : 'Confirmar mi reserva'}{' '}
                <span aria-hidden="true">↗</span>
              </button>
              <p class="form-footnote">
                Máximo 4 hogazas por reserva. Sin suscripciones.
              </p>
              <noscript>
                <p>
                  Activa JavaScript para ver la confirmación en esta página.{' '}
                  {brand.contact && (
                    <a href={`mailto:${brand.contact}`}>
                      También puedes escribirme para reservar.
                    </a>
                  )}
                </p>
              </noscript>
            </form>
          ) : (
            <div class="closed-panel">
              <span class="eyebrow">{statusLabel}</span>
              <h3>
                El buen pan
                <br />
                puede esperar.
                <br />
                El aviso, no.
              </h3>
              <p>
                Déjame tu email y te avisaré cuando abra la próxima hornada.
              </p>
              <a class="button" href="#avisame">
                Avísame <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
          <div id="confirmation" hidden tabindex="-1" role="status"></div>
        </div>
      </div>
    </section>
    <section class="faq-section wrap">
      <div>
        <p class="eyebrow">POR SI TE LO PREGUNTAS</p>
        <h2>Antes de partir el pan.</h2>
      </div>
      <div class="faq-list">
        {[
          [
            '¿Qué lleva la hogaza clásica?',
            'Harina de trigo, agua, masa madre de trigo y sal. Contiene gluten. Si tienes otra alergia, consulta antes de reservar; la producción se hace en una cocina compartida.',
          ],
          [
            '¿Cómo lo conservo?',
            'Guárdalo entero en un lugar fresco y seco, envuelto en un paño limpio. Si no lo vas a comer pronto, puedes cortarlo en rebanadas y congelarlo.',
          ],
          [
            '¿Puedo pedir que me lo envíes?',
            'Por ahora solo hay recogida local en Santa Coloma de Cervelló. Quiero empezar cerca y con una producción pequeña.',
          ],
          [
            '¿Cómo pago?',
            'Al recoger el pan. No necesitas introducir una tarjeta para reservar.',
          ],
          [
            '¿Y si no puedo venir?',
            'Escríbeme cuanto antes con la referencia de tu reserva. Así puedo organizar la hornada y liberar tu pan si aún estamos a tiempo.',
          ],
          [
            '¿Y si llego cuando ya no queda?',
            'Apúntate al aviso de la próxima hornada. Ese aviso no reserva pan automáticamente; tú eliges si te apetece encargar.',
          ],
        ].map(([q, a]) => (
          <details>
            <summary>
              {q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
    <section id="avisame" class="waitlist-section wrap">
      <div>
        <p class="eyebrow">EL PRÓXIMO SÁBADO EMPIEZA AQUÍ</p>
        <h2>
          Cuando haya pan,
          <br />
          te aviso.
        </h2>
        <p>
          Un email al abrir la hornada.
          <br />Y te das de baja cuando quieras.
        </p>
      </div>
      <form id="waitlist-form" action="/api/waitlist" method="post">
        <label for="waitlist-email">Tu email</label>
        <div class="waitlist-input">
          <input
            id="waitlist-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
            placeholder="tu@email.com"
            disabled={!canSubmit}
          />
          <button class="button" type="submit" disabled={!canSubmit}>
            Avísame <span aria-hidden="true">↗</span>
          </button>
        </div>
        <input type="hidden" name="source" value="direct" />
        <div class="honey" aria-hidden="true">
          <input
            name="website"
            aria-label="Deja vacío"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <label class="check">
          <input
            type="checkbox"
            name="consent"
            value="yes"
            required
            disabled={!canSubmit}
          />
          <span>
            Quiero recibir avisos de hornadas y acepto la{' '}
            <a href="/privacidad">política de privacidad</a>.
          </span>
        </label>
        {!canSubmit && (
          <p>Los avisos se activarán al anunciar la primera hornada.</p>
        )}
        {isDemo && (
          <p class="form-footnote">Modo de prueba: no recibirás emails.</p>
        )}
        <p class="form-error" role="alert" tabindex="-1" hidden></p>
        <p class="waitlist-success" role="status" hidden>
          Ya estás en la lista. Te avisaré cuando abra la próxima hornada.
        </p>
      </form>
    </section>
  </main>
  <div class="mobile-cta" role="navigation" aria-label="Reserva rápida">
    <span>Tu hogaza · {money(products[0].price)}</span>
    <a class="button" href={open ? '#reserva' : '#avisame'}>
      {open ? 'Reservar' : 'Avísame'} ↗
    </a>
  </div>
</Base>
