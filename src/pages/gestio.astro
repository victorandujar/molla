---
import Base from '../layouts/Base.astro';
import {
  adminEnabled,
  checkPassword,
  createSession,
  validSession,
  sessionCookie,
  sessionHours,
} from '../lib/admin';
import { randomUUID } from 'node:crypto';
import {
  currentBake,
  listBakes,
  ordersForBake,
  reserve,
  setOrderStatus,
  waitlistCounts,
  funnel,
  rateLimit,
} from '../lib/store';
import {
  bakeState,
  bananaSplit,
  giftCroissants,
  orderItems,
  orderSummary,
  type Order,
  hasMailbox,
  standingDayOf,
  reservationSchema,
} from '../lib/domain';
import { deliveryTowns } from '../lib/delivery';
import { AppError, messages, isMessageKey } from '../lib/messages';
import { townById, deliveryWindow, eveningWindow } from '../lib/delivery';
import { funnelEmailCounts } from '../lib/funnel';
import {
  money,
  STANDING_GOAL_LOAVES,
  BANANA_HALVES_PER_BAKE,
  PASTRY_UNITS_PER_BAKE,
} from '../lib/config';
import { pickupDay } from '../lib/email-templates';
import { routes, standingFrequency, ui } from '../lib/i18n';
import { clientIp, after, issue } from '../lib/http';
import { sendCancelledByOwner } from '../lib/email';
// Owner's panel for the pickup point: today's orders, mark collected or
// cancelled from the phone. Spanish only; it is not a public page.
if (!adminEnabled()) return new Response('Not found', { status: 404 });
const cookie = {
  httpOnly: true,
  secure: import.meta.env.PROD,
  sameSite: 'strict' as const,
  path: '/gestio',
};
const signedIn = validSession(Astro.cookies.get(sessionCookie)?.value);
let loginError = '';
if (Astro.request.method === 'POST') {
  if (Astro.request.headers.get('origin') !== Astro.url.origin)
    return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  const action = String(form.get('action') || '');
  if (action === 'login') {
    if (!(await rateLimit(`login|${clientIp(Astro)}`, 5))) {
      loginError = 'Demasiados intentos. Espera diez minutos.';
    } else if (checkPassword(String(form.get('password') || ''))) {
      Astro.cookies.set(sessionCookie, createSession(), {
        ...cookie,
        maxAge: sessionHours * 3600,
      });
      return Astro.redirect('/gestio', 303);
    } else {
      loginError = 'Contraseña incorrecta.';
    }
  } else if (action === 'logout') {
    Astro.cookies.delete(sessionCookie, cookie);
    return Astro.redirect('/gestio', 303);
  } else if (signedIn && action === 'sub') {
    // Pause, resume or cancel a pa fix for a customer who asked by phone.
    const to = String(form.get('to'));
    const id = String(form.get('sub'));
    let ok = false;
    if (to === 'PAUSED' || to === 'ACTIVE' || to === 'CANCELLED') {
      const target = (await listSubscriptions()).find((s) => s.id === id);
      if (target) ok = !!(await setSubscriptionStatus(target.token, to));
    }
    const query = new URLSearchParams({ subdone: ok ? to : 'none' });
    return Astro.redirect(`/gestio?${query.toString()}#panfijo`, 303);
  } else if (signedIn && action === 'manual') {
    // An order taken by Instagram, WhatsApp or in person, so the panel and
    // the bake count every loaf. No emails go out: the customer already
    // talked to the baker.
    let why = '';
    let bakeId = '';
    try {
      const active = await currentBake();
      bakeId = active.id;
      const fields = Object.fromEntries(
        [...form.entries()].map(([k, v]) => [k, String(v)]),
      );
      const parsed = reservationSchema.safeParse({
        ...fields,
        requestId: randomUUID(),
        bakeId: active.id,
        privacy: 'yes',
        lang: 'es',
      });
      if (!parsed.success) why = issue(parsed.error, 'invalid');
      else await reserve({ ...parsed.data, lang: 'es' });
    } catch (e) {
      why = e instanceof AppError ? e.key : 'reservationFailed';
      if (!(e instanceof AppError))
        console.error(
          'Manual order failed',
          e instanceof Error ? e.message : e,
        );
    }
    const query = new URLSearchParams({ bake: bakeId, manual: why || 'ok' });
    return Astro.redirect(`/gestio?${query.toString()}#manual`, 303);
  } else if (signedIn && action === 'status') {
    const to = String(form.get('to'));
    const id = String(form.get('id'));
    const bake = String(form.get('bake') || '');
    let ok = false;
    if (to === 'COLLECTED' || to === 'CANCELLED' || to === 'CONFIRMED') {
      const changed = await setOrderStatus(id, to);
      ok = !!changed;
      // The customer gets an apology email, sent after the redirect.
      if (changed && to === 'CANCELLED') after(sendCancelledByOwner(changed));
    }
    const query = new URLSearchParams({ bake, done: ok ? to : 'none' });
    return Astro.redirect(`/gestio?${query.toString()}#pedidos`, 303);
  }
}
const labels: Record<Order['status'], string> = {
  CONFIRMED: 'Pendiente',
  COLLECTED: 'Recogido',
  CANCELLED: 'Cancelado',
};
const order = { CONFIRMED: 0, COLLECTED: 1, CANCELLED: 2 };
let data: null | {
  bakes: Awaited<ReturnType<typeof listBakes>>;
  bake: Awaited<ReturnType<typeof currentBake>>;
  orders: Awaited<ReturnType<typeof ordersForBake>>;
  waitlist: Awaited<ReturnType<typeof waitlistCounts>>;
  events: Record<string, number>;
  standing: Awaited<ReturnType<typeof subscriptionStats>>;
  subs: Awaited<ReturnType<typeof listSubscriptions>>;
  sends: Record<string, number>;
  candidates: StandingCandidate[];
} = null;
let loadError = '';
if (signedIn) {
  try {
    const [bakes, active, waitlist, events, standing, subs, sends, candidates] =
      await Promise.all([
        listBakes(),
        currentBake(),
        waitlistCounts(),
        funnel(28),
        subscriptionStats(),
        listSubscriptions(),
        // Before migration 008 the table does not exist: show zeros.
        funnelEmailCounts(28).catch(() => ({}) as Record<string, number>),
        standingCandidates(),
      ]);
    // After Thursday's close the shop shows next week's bake, but the panel
    // keeps showing the one still to bake and deliver.
    const toBake = bakes.findLast(
      (b) =>
        b.status !== 'COMPLETED' &&
        Date.parse(b.pickupDate) > Date.now() - 12 * 3600000,
    );
    const bake =
      bakes.find((b) => b.id === Astro.url.searchParams.get('bake')) ||
      toBake ||
      active;
    const orders = (await ordersForBake(bake.id)).sort(
      (a, b) =>
        order[a.status] - order[b.status] || a.name.localeCompare(b.name),
    );
    data = {
      bakes,
      bake,
      orders,
      waitlist,
      events,
      standing,
      subs,
      sends,
      candidates,
    };
  } catch (e) {
    console.error('Admin panel failed', e instanceof Error ? e.message : e);
    loadError = 'No se han podido cargar los datos. Recarga en unos segundos.';
  }
}
const done = Astro.url.searchParams.get('done');
const notice =
  done === 'none'
    ? 'Ese pedido ya había cambiado de estado. Revisa la lista.'
    : done
      ? done === 'CANCELLED'
        ? 'Pedido cancelado. El cliente recibirá un email avisándole.'
        : `Pedido marcado como ${labels[done as Order['status']]?.toLowerCase() || 'actualizado'}.`
      : '';
const manual = Astro.url.searchParams.get('manual');
const manualNotice = !manual
  ? ''
  : manual === 'ok'
    ? 'Pedido apuntado. Ya cuenta en la hornada y en la lista de pedidos.'
    : `No se ha podido apuntar: ${isMessageKey(manual) ? messages.es[manual] : 'revisa los datos.'}`;
const subDone = Astro.url.searchParams.get('subdone');
const subNotice =
  subDone === 'none'
    ? 'Ese pan fijo ya había cambiado. Revisa la lista.'
    : subDone === 'PAUSED'
      ? 'Pan fijo pausado. Su pedido abierto de esta semana se ha cancelado.'
      : subDone === 'ACTIVE'
        ? 'Pan fijo reanudado.'
        : subDone === 'CANCELLED'
          ? 'Pan fijo dado de baja. Su pedido abierto de esta semana se ha cancelado.'
          : '';
const subItems = (s: NonNullable<typeof data>['subs'][number]) => {
  const names = ui.es.catalog;
  const { whole, half } = bananaSplit(s.banana);
  return [
    s.quantity ? `${s.quantity} × ${names.loaf}` : '',
    whole ? `${whole} × ${names.bananaWhole}` : '',
    half ? `${half} × ${names.bananaHalf}` : '',
  ]
    .filter(Boolean)
    .join(' · ');
};
const subStatus = {
  ACTIVE: 'Activo',
  PAUSED: 'En pausa',
  CANCELLED: 'De baja',
};
const live = data?.orders.filter((o) => o.status !== 'CANCELLED') || [];
const pending = live.filter((o) => o.status === 'CONFIRMED');
// Pieces of one product across the bake's live orders, to know what to bake.
const pieces = (orders: Order[], product: string) =>
  orders.reduce(
    (n, o) =>
      n +
      orderItems(o)
        .filter((i) => i.product === product)
        .reduce((m, i) => m + i.quantity, 0),
    0,
  );
// The pa fix offer, sent by the baker in person to someone who already
// ordered: their language, their first name and the sign-up link.
const offerStanding = (c: StandingCandidate) => {
  const first = c.name.split(' ')[0];
  const link = new URL(routes.standing[c.lang], Astro.url.origin).href;
  return c.lang === 'ca'
    ? `Hola, ${first}! Sóc el Víctor, de Molla. Estic organitzant el pa per a clients fixos: et guardo el teu pa cada setmana, te’l porto a casa i el pagues en rebre’l. Si una setmana no el vols, el saltes amb un clic. T’hi apunto? Aquí ho tens: ${link}`
    : `¡Hola, ${first}! Soy Víctor, de Molla. Estoy organizando el pan para clientes fijos: te guardo tu hogaza cada semana, te la llevo a casa y la pagas al recibirla. Si una semana no la quieres, la saltas con un clic. ¿Te apunto? Aquí lo tienes: ${link}`;
};
// The message for the day: "on my way" for home delivery, "ready" for pickup,
// in the customer's language, so the baker only has to press send.
const onTheWay = (o: Order) => {
  const first = o.name.split(' ')[0];
  const ca = o.lang === 'ca';
  if (o.delivery)
    return ca
      ? `Hola, ${first}! Sóc el Víctor, de Molla. Surto ara amb la teva comanda; arribo en uns 15 minuts.`
      : `¡Hola, ${first}! Soy Víctor, de Molla. Salgo ahora con tu pedido; llego en unos 15 minutos.`;
  return ca
    ? `Hola, ${first}! Sóc el Víctor, de Molla. La teva comanda ja està a punt per recollir.`
    : `¡Hola, ${first}! Soy Víctor, de Molla. Tu pedido ya está listo para recoger.`;
};
const whatsapp = (phone: string) => {
  const digits = phone.replace(/\D/g, '');
  return `https://wa.me/${digits.length === 9 ? `34${digits}` : digits}`;
};
const steps = [
  ['landing_view', 'Visitas'],
  ['view_current_bake', 'Ven la hornada'],
  ['click_reserve', 'Pulsan «Reservar» en una página'],
  ['start_reservation', 'Empiezan a reservar'],
  ['form_start', 'Empiezan a rellenar sus datos'],
  ['reservation_submit', 'Pulsan «Confirmar la reserva»'],
  ['reservation_error', 'Les sale un error al reservar'],
  ['reservation_completed', 'Reservan'],
  ['click_whatsapp_order', 'Pulsan «Reservar por WhatsApp»'],
  ['click_whatsapp', 'Pulsan WhatsApp (dudas y otros)'],
  ['waitlist_signup', 'Se apuntan al aviso'],
] as const;
import {
  listSubscriptions,
  setSubscriptionStatus,
  standingCandidates,
  subscriptionStats,
  weeklyLoaves,
  type StandingCandidate,
} from '../lib/subscriptions';
---

<Base lang="es" title="Gestión · Molla" noindex>
  <main id="contenido" class="admin wrap">
    {!signedIn ? (
      <form method="post" class="admin-login">
        <p class="kicker">Gestión</p>
        <h1>Entrar</h1>
        <input type="hidden" name="action" value="login" />
        <div class="field">
          <label for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            required
          />
        </div>
        {loginError && (
          <p class="form-error" role="alert">
            {loginError}
          </p>
        )}
        <button class="button full" type="submit">
          Entrar
        </button>
      </form>
    ) : !data ? (
      <p role="alert">{loadError}</p>
    ) : (
      <>
        <header class="admin-head">
          <div>
            <p class="kicker">
              Hornada {data.bake.number} ·{' '}
              {ui.es.status[bakeState(data.bake, data.bake.reserved)]}
            </p>
            <h1>{pickupDay(data.bake.pickupDate)}</h1>
            <p>{data.bake.pickupWindow || 'Franja sin definir'}</p>
          </div>
          <form method="post">
            <input type="hidden" name="action" value="logout" />
            <button class="text-link" type="submit">
              Salir
            </button>
          </form>
        </header>
        {data.bakes.length > 1 && (
          <nav class="admin-bakes" aria-label="Hornadas">
            {data.bakes.map((b) => (
              <a
                href={`/gestio?bake=${b.id}`}
                aria-current={b.id === data!.bake.id ? 'page' : undefined}
              >
                {b.number}
              </a>
            ))}
          </nav>
        )}
        <dl class="admin-stats">
          <div>
            <dt>Pan reservado (los tres)</dt>
            <dd>
              {data.bake.reserved} / {data.bake.capacity}
            </dd>
          </div>
          <div>
            <dt>La de cada semana</dt>
            <dd>{pieces(live, 'clasica')}</dd>
          </div>
          <div>
            <dt>Masa madre</dt>
            <dd>{pieces(live, 'masa-madre')}</dd>
          </div>
          <div>
            <dt>Integral 60 %</dt>
            <dd>{pieces(live, 'integral')}</dd>
          </div>
          <div>
            <dt>Banana bread</dt>
            <dd>
              {data.bake.bananaReserved / 2} / {BANANA_HALVES_PER_BAKE / 2}
            </dd>
          </div>
          <div>
            <dt>Bollería</dt>
            <dd>
              {data.bake.pastryReserved} / {PASTRY_UNITS_PER_BAKE}
            </dd>
          </div>
          <div>
            <dt>Croissants</dt>
            <dd>{pieces(live, 'croissant')}</dd>
          </div>
          <div>
            <dt>Croissants de regalo</dt>
            <dd>{live.reduce((n, o) => n + giftCroissants(o), 0)}</dd>
          </div>
          <div>
            <dt>Pains au chocolat</dt>
            <dd>{pieces(live, 'pain-au-chocolat')}</dd>
          </div>
          <div>
            <dt>Hogazas por recoger</dt>
            <dd>{pending.reduce((n, o) => n + o.quantity, 0)}</dd>
          </div>
          <div>
            <dt>Por cobrar</dt>
            <dd>{money(pending.reduce((n, o) => n + o.total, 0))}</dd>
          </div>
          <div>
            <dt>Recogidas</dt>
            <dd>{live.length - pending.length}</dd>
          </div>
        </dl>
        {notice && (
          <p class="admin-notice" role="status">
            {notice}
          </p>
        )}
        <section id="pedidos" aria-labelledby="orders-title">
          <h2 id="orders-title">Pedidos</h2>
          {data.orders.length === 0 && (
            <p>Todavía no hay pedidos en esta hornada.</p>
          )}
          <ul class="admin-orders">
            {data.orders.map((o) => (
              <li data-status={o.status}>
                <div class="admin-order-top">
                  <strong class="admin-code">{o.code}</strong>
                  <span class="admin-badge">{labels[o.status]}</span>
                  {o.subscription && <span class="admin-badge">Pan fijo</span>}
                  {o.firstOrder && (
                    <span class="admin-badge">Primera · vale pan fijo</span>
                  )}
                  {giftCroissants(o) > 0 && (
                    <span class="admin-badge">
                      🎁 {giftCroissants(o)} croissant
                      {giftCroissants(o) > 1 ? 's' : ''} de regalo
                      {o.invited ? ' · invitado' : ''}
                    </span>
                  )}
                </div>
                <p class="admin-name">
                  {o.name} · {orderSummary(o)} ={' '}
                  <strong>{money(o.total)}</strong>
                </p>
                <p class="admin-contact">
                  <a href={`tel:${o.phone.replace(/[^\d+]/g, '')}`}>
                    {o.phone}
                  </a>
                  <a
                    href={whatsapp(o.phone)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    WhatsApp ↗
                  </a>
                  {o.status === 'CONFIRMED' && (
                    <a
                      href={`${whatsapp(o.phone)}?text=${encodeURIComponent(onTheWay(o))}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {o.delivery
                        ? 'Avisar «salgo ahora»'
                        : 'Avisar «ya está listo»'}{' '}
                      ↗
                    </a>
                  )}
                  {hasMailbox(o.email) ? (
                    <a
                      href={`mailto:${o.email}?subject=${encodeURIComponent(`Reserva ${o.code}`)}`}
                    >
                      {o.email}
                    </a>
                  ) : (
                    <span>Sin email</span>
                  )}
                </p>
                {o.delivery && (
                  <p class="admin-contact">
                    <strong>
                      A domicilio · {o.delivery.town} · {o.pickupWindow}
                    </strong>
                    {o.delivery.address && (
                      <a
                        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${o.delivery.address}, ${o.delivery.town}`)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {o.delivery.address} ↗
                      </a>
                    )}
                    {o.delivery.notes && (
                      <span>Si no está: {o.delivery.notes}</span>
                    )}
                  </p>
                )}
                <p class="admin-meta">
                  Email {o.emailStatus.toLowerCase()} · Recordatorio{' '}
                  {o.reminderSentAt ? 'enviado' : 'no enviado'} · {o.source}
                </p>
                <div class="admin-actions">
                  {o.status === 'CONFIRMED' && (
                    <form method="post">
                      <input type="hidden" name="action" value="status" />
                      <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="bake" value={data!.bake.id} />
                      <button
                        class="button"
                        name="to"
                        value="COLLECTED"
                        type="submit"
                      >
                        Marcar recogido
                      </button>
                    </form>
                  )}
                  {o.status === 'COLLECTED' && (
                    <form method="post">
                      <input type="hidden" name="action" value="status" />
                      <input type="hidden" name="id" value={o.id} />
                      <input type="hidden" name="bake" value={data!.bake.id} />
                      <button
                        class="text-link"
                        name="to"
                        value="CONFIRMED"
                        type="submit"
                      >
                        Deshacer
                      </button>
                    </form>
                  )}
                  {o.status === 'CONFIRMED' && (
                    <details>
                      <summary>Cancelar…</summary>
                      <form method="post">
                        <input type="hidden" name="action" value="status" />
                        <input type="hidden" name="id" value={o.id} />
                        <input
                          type="hidden"
                          name="bake"
                          value={data!.bake.id}
                        />
                        <p>
                          Libera {orderSummary(o)} y avisa al cliente por email.
                          No se puede deshacer.
                        </p>
                        <button
                          class="button admin-danger"
                          name="to"
                          value="CANCELLED"
                          type="submit"
                        >
                          Sí, cancelar {o.code}
                        </button>
                      </form>
                    </details>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
        <section id="manual" aria-labelledby="manual-title">
          <h2 id="manual-title">Apuntar un pedido</h2>
          <p class="admin-meta">
            Para los pedidos que te llegan por Instagram, WhatsApp o en persona.
            Va a la hornada que está abierta ({data.bake.number}) y no envía
            ningún email.
          </p>
          {manualNotice && (
            <p class="admin-notice" role="status">
              {manualNotice}
            </p>
          )}
          <details class="admin-manual" open={!!manual && manual !== 'ok'}>
            <summary class="button">+ Pedido manual</summary>
            <form method="post" class="admin-manual-form">
              <input type="hidden" name="action" value="manual" />
              <div class="field">
                <label for="m-source">Por dónde llegó</label>
                <select id="m-source" name="source">
                  <option value="instagram">Instagram</option>
                  <option value="whatsapp">WhatsApp</option>
                  <option value="whatsapp_web">
                    WhatsApp desde la web («Quiero reservar pan…»)
                  </option>
                  <option value="facebook">Facebook</option>
                  <option value="referral">Un amigo o vecino</option>
                  <option value="direct">En persona o por teléfono</option>
                </select>
              </div>
              <div class="form-columns">
                <div class="field">
                  <label for="m-quantity">La de cada semana</label>
                  <input
                    id="m-quantity"
                    name="quantity"
                    type="number"
                    inputmode="numeric"
                    min="0"
                    max="4"
                    value="0"
                  />
                </div>
                <div class="field">
                  <label for="m-sourdough">Masa madre</label>
                  <input
                    id="m-sourdough"
                    name="sourdough"
                    type="number"
                    inputmode="numeric"
                    min="0"
                    max="4"
                    value="0"
                  />
                </div>
                <div class="field">
                  <label for="m-wholegrain">Integral 60 %</label>
                  <input
                    id="m-wholegrain"
                    name="wholegrain"
                    type="number"
                    inputmode="numeric"
                    min="0"
                    max="4"
                    value="0"
                  />
                </div>
                <div class="field">
                  <label for="m-banana">Banana bread (mitades)</label>
                  <input
                    id="m-banana"
                    name="banana"
                    type="number"
                    inputmode="numeric"
                    min="0"
                    max="4"
                    value="0"
                  />
                </div>
                <div class="field">
                  <label for="m-croissant">Croissants</label>
                  <input
                    id="m-croissant"
                    name="croissant"
                    type="number"
                    inputmode="numeric"
                    min="0"
                    max="12"
                    value="0"
                  />
                </div>
                <div class="field">
                  <label for="m-pain">Pains au chocolat</label>
                  <input
                    id="m-pain"
                    name="pain"
                    type="number"
                    inputmode="numeric"
                    min="0"
                    max="12"
                    value="0"
                  />
                </div>
              </div>
              <div class="field">
                <label for="m-delivery">Entrega</label>
                <select id="m-delivery" name="delivery">
                  <option value="home">A domicilio</option>
                  <option value="pickup">Recoge en Sant Boi</option>
                </select>
              </div>
              <div class="field">
                <label for="m-slot">Franja (a domicilio)</label>
                <select id="m-slot" name="slot">
                  <option value="midday">Mediodía · {deliveryWindow}</option>
                  <option value="evening">
                    Tarde · {eveningWindow} (solo miércoles)
                  </option>
                </select>
              </div>
              <div class="form-columns">
                <div class="field">
                  <label for="m-town">Municipio (a domicilio)</label>
                  <select id="m-town" name="town">
                    <option value="">—</option>
                    {deliveryTowns.map((town) => (
                      <option value={town.id}>{town.name}</option>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label for="m-address">Dirección (a domicilio)</label>
                  <input id="m-address" name="address" maxlength="160" />
                </div>
              </div>
              <div class="field">
                <label for="m-notes">Notas de entrega (opcional)</label>
                <input id="m-notes" name="notes" maxlength="200" />
              </div>
              <div class="form-columns">
                <div class="field">
                  <label for="m-name">Nombre</label>
                  <input
                    id="m-name"
                    name="name"
                    minlength="2"
                    maxlength="100"
                    required
                  />
                </div>
                <div class="field">
                  <label for="m-phone">Móvil</label>
                  <input
                    id="m-phone"
                    name="phone"
                    type="tel"
                    minlength="9"
                    maxlength="22"
                    required
                  />
                </div>
              </div>
              <div class="field">
                <label for="m-email">Email (opcional)</label>
                <input id="m-email" name="email" type="email" maxlength="254" />
              </div>
              <button class="button full" type="submit">
                Apuntar pedido
              </button>
            </form>
          </details>
        </section>
        <section id="panfijo" aria-labelledby="panfijo-title">
          <h2 id="panfijo-title">
            Pan fijo ({data.standing.active} activos
            {data.standing.paused > 0 && `, ${data.standing.paused} en pausa`})
          </h2>
          {(() => {
            const loaves = weeklyLoaves(data.subs);
            const shown = Number.isInteger(loaves)
              ? String(loaves)
              : loaves.toFixed(1).replace('.', ',');
            return (
              <div class="admin-goal">
                <p>
                  Objetivo:{' '}
                  <strong>
                    {shown} / {STANDING_GOAL_LOAVES}
                  </strong>{' '}
                  panes fijos por semana
                </p>
                <meter
                  min="0"
                  max={STANDING_GOAL_LOAVES}
                  value={Math.min(loaves, STANDING_GOAL_LOAVES)}
                  aria-label="Panes fijos por semana"
                ></meter>
                <p class="admin-meta">
                  Un pan fijo cada dos semanas cuenta como medio.
                </p>
              </div>
            );
          })()}
          {subNotice && (
            <p class="admin-notice" role="status">
              {subNotice}
            </p>
          )}
          {data.subs.length === 0 && <p>Todavía no hay nadie con pan fijo.</p>}
          <ul class="admin-orders">
            {data.subs.map((s) => (
              <li
                data-status={
                  s.status === 'CANCELLED' ? 'CANCELLED' : 'CONFIRMED'
                }
              >
                <div class="admin-order-top">
                  <strong class="admin-code">{s.name}</strong>
                  <span class="admin-badge">{subStatus[s.status]}</span>
                </div>
                <p class="admin-name">
                  {subItems(s)} ·{' '}
                  {standingFrequency(
                    'es',
                    s.frequency,
                    standingDayOf(s),
                  ).toLowerCase()}
                  {s.skipRemaining > 0 && ' · salta la próxima entrega'}
                </p>
                <p class="admin-contact">
                  <a href={`tel:${s.phone.replace(/[^\d+]/g, '')}`}>
                    {s.phone}
                  </a>
                  <a
                    href={whatsapp(s.phone)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    WhatsApp ↗
                  </a>
                  <a href={`mailto:${s.email}`}>{s.email}</a>
                </p>
                <p class="admin-meta">
                  {s.delivery === 'home'
                    ? `A domicilio · ${townById(s.town)?.name ?? s.town} · ${s.address}`
                    : 'Recogida en Sant Boi'}
                </p>
                {s.status !== 'CANCELLED' && (
                  <div class="admin-actions">
                    <form method="post">
                      <input type="hidden" name="action" value="sub" />
                      <input type="hidden" name="sub" value={s.id} />
                      <button
                        class="button"
                        name="to"
                        value={s.status === 'ACTIVE' ? 'PAUSED' : 'ACTIVE'}
                        type="submit"
                      >
                        {s.status === 'ACTIVE' ? 'Pausar' : 'Reanudar'}
                      </button>
                    </form>
                    <details>
                      <summary>Dar de baja…</summary>
                      <form method="post">
                        <input type="hidden" name="action" value="sub" />
                        <input type="hidden" name="sub" value={s.id} />
                        <p>
                          Deja de prepararle pedidos y cancela el de esta semana
                          si aún está abierto. No se puede deshacer: tendría que
                          volver a apuntarse.
                        </p>
                        <button
                          class="button admin-danger"
                          name="to"
                          value="CANCELLED"
                          type="submit"
                        >
                          Sí, dar de baja a {s.name}
                        </button>
                      </form>
                    </details>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
        <section id="ofrecer" aria-labelledby="ofrecer-title">
          <h2 id="ofrecer-title">
            Ofrecer pan fijo ({data.candidates.length})
          </h2>
          <p>
            Ya te han comprado y todavía no tienen pan fijo. El botón abre
            WhatsApp con la propuesta escrita en su idioma.
          </p>
          {data.candidates.length === 0 && <p>Nadie pendiente por ahora.</p>}
          <ul class="admin-orders">
            {data.candidates.map((c) => (
              <li data-status="CONFIRMED">
                <div class="admin-order-top">
                  <strong class="admin-code">{c.name}</strong>
                  <span class="admin-badge">
                    {c.orders} {c.orders === 1 ? 'pedido' : 'pedidos'}
                  </span>
                </div>
                <p class="admin-meta">
                  Último: {pickupDay(c.lastDate)} ·{' '}
                  {c.lang === 'ca' ? 'catalán' : 'castellano'}
                </p>
                <p class="admin-contact">
                  <a
                    href={`${whatsapp(c.phone)}?text=${encodeURIComponent(offerStanding(c))}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Ofrecer pan fijo por WhatsApp ↗
                  </a>
                </p>
              </li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="funnel-title">
          <h2 id="funnel-title">Últimos 28 días</h2>
          <dl class="admin-stats">
            {steps.map(([key, label]) => (
              <div>
                <dt>{label}</dt>
                <dd>{data!.events[key] || 0}</dd>
              </div>
            ))}
            <div>
              <dt>Pan fijo activos</dt>
              <dd>
                {data.standing.active} ({data.standing.loaves} hogazas/semana)
              </dd>
            </div>
            <div>
              <dt>Pan fijo en pausa</dt>
              <dd>{data.standing.paused}</dd>
            </div>
            <div>
              <dt>Avisos confirmados</dt>
              <dd>{data.waitlist.confirmed}</dd>
            </div>
            <div>
              <dt>Avisos sin confirmar</dt>
              <dd>{data.waitlist.pending}</dd>
            </div>
            {(
              [
                ['open', 'Emails «hornada abierta»'],
                ['last', 'Emails «último aviso»'],
                ['thanks', 'Emails «¿qué tal el pan?»'],
                ['pafix', 'Emails oferta pan fijo'],
                ['reward', 'Emails regalo por invitar'],
                ['campaign', 'Emails de campaña (Navidad…)'],
              ] as const
            ).map(([key, label]) => (
              <div>
                <dt>{label}</dt>
                <dd>{data!.sends[key] || 0}</dd>
              </div>
            ))}
          </dl>
        </section>
      </>
    )}
  </main>
</Base>
