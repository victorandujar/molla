---
import Article from '../layouts/Article.astro';
import Photo from '../components/Photo.astro';
import { brand, isDemo, launchReady } from '../lib/config';
import { dayFormat, madridParts } from '../lib/i18n';
import { currentBake } from '../lib/store';
let current: Awaited<ReturnType<typeof currentBake>> | undefined;
if (isDemo || launchReady) {
  try {
    current = await currentBake();
  } catch {
    /* Shows the weekly rhythm without a date. */
  }
}
const close = current && madridParts('ca', current.deadline);
const place = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: `Punt de recollida ${brand.name}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sant Boi de Llobregat',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
};
---

<Article
  lang="ca"
  route="pickup"
  crumb="Recollida"
  title={`Recollida de pa artesà a Sant Boi de Llobregat · ${brand.name}`}
  description="On i quan recollir el teu pa de fermentació lenta a Sant Boi de Llobregat. Reserva en línia, recull-lo dissabte i paga en recollir. El punt exacte es confirma amb la comanda."
  kicker="Recollida · Sant Boi de Llobregat"
  h1="Recull el teu pa a Sant Boi de Llobregat."
  lede="Un cop per setmana, dissabte, a Sant Boi de Llobregat. Reserves abans, pagues en recollir i t’emportes el pa del dia."
  jsonLd={[place]}
>
  <div class="article-grid">
    <div class="prose">
      <h2>On</h2>
      <p>
        <strong>Punt de recollida a Sant Boi de Llobregat.</strong> Et
        confirmarem el punt exacte de recollida amb la teva comanda.
      </p>

      <h2>Quan</h2>
      <p>
        {current ? (
          <>
            Els dissabtes. La propera recollida és{' '}
            <strong>{dayFormat('ca', current.pickupDate)}</strong>
            {current.pickupWindow
              ? `, ${current.pickupWindow}`
              : '. L’horari de recollida es confirma amb la comanda'}
            . Les comandes es tanquen {close!.weekday} {close!.day} a les{' '}
            {close!.time} o quan s’acaba la fornada.
          </>
        ) : (
          <>
            Dissabte · horari de recollida confirmat amb la comanda. Les
            comandes es tanquen dos dies abans a les 20:00 o quan s’acaba la
            fornada.
          </>
        )}
      </p>

      <h2>Com funciona</h2>
      <ol>
        <li>
          Reserves a la web i reps per correu una confirmació amb el teu codi de
          recollida. El dia abans t’arriba un recordatori.
        </li>
        <li>Dissabte vens al punt de recollida dins de la franja horària.</li>
        <li>
          Dius el teu codi, pagues i t’emportes el pa, cuit aquell mateix dia.
        </li>
      </ol>
      <p>
        Si al final no pots venir, respon el correu de confirmació com més aviat
        millor amb el teu codi: així allibero el teu pa per a una altra persona.
      </p>

      <h2>Si vens de fora de Sant Boi</h2>
      <p>
        Faig pa per a tot el Baix Llobregat. La recollida és a Sant Boi de
        Llobregat, també si vius a Santa Coloma de Cervelló, Sant Vicenç dels
        Horts, Cornellà de Llobregat, Sant Joan Despí, Viladecans o Sant Climent
        de Llobregat. De moment no faig enviaments a domicili.
      </p>
    </div>
    <figure class="article-photo">
      <Photo
        name="hands"
        alt="Mà que subjecta un pa de crosta fosca mentre es talla amb un ganivet de pa"
        sizes="(max-width: 860px) calc(100vw - 40px), 40vw"
      />
    </figure>
  </div>
</Article>
