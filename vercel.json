{
  "regions": [
    "lhr1"
  ],
  "headers": [
    {
      "source": "/alta",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/baja",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/comanda",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/subscripcio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/gestio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/cycle",
      "schedule": "5 19 * * *"
    },
    {
      "path": "/api/cron/amasado/noche-1",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/amasado/noche-2",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/amasado/manana-1",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/amasado/manana-2",
      "schedule": "0 6 * * *"
    }
  ]
}
